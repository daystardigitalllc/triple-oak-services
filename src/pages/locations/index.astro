---
// src/pages/locations/index.astro
// Locations Hub Page - lists and links to every location detail page.
import MainLayout from '../../layouts/MainLayout.astro';
import contentData from '../../data/content.json';
import businessData from '../../data/business.json';
import CTA from '../../components/CTA.astro';
---

<MainLayout
  title={`Our Service Areas | ${businessData.name}`}
  description={`${businessData.name} proudly serves ${businessData.locations.join(', ')} and the surrounding area.`}
>
  <!-- Hero Banner -->
  <section class="relative pt-32 pb-20 lg:pt-40 lg:pb-24 bg-neutral-950 text-white overflow-hidden text-center select-none">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-[350px] h-[350px] bg-primary/20 rounded-full blur-[100px] animate-pulse-slow"></div>
      <div class="absolute bottom-1/4 right-1/4 w-[300px] h-[300px] bg-accent/15 rounded-full blur-[80px]"></div>
    </div>

    <div class="container mx-auto px-6 relative z-10 max-w-3xl space-y-6">
      <span class="text-xs font-bold uppercase tracking-wider text-primary bg-primary/10 px-3.5 py-1.5 rounded-full">
        Service Areas
      </span>
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight uppercase leading-[1.1] text-white">
        Where We Serve
      </h1>
      <p class="text-base sm:text-lg text-neutral-300 max-w-xl mx-auto leading-relaxed">
        Proudly serving customers throughout the area with licensed, professional {businessData.industry} services.
      </p>
    </div>
  </section>

  <!-- Locations Grid -->
  <section class="py-24 bg-white dark:bg-neutral-950 relative border-t border-neutral-100 dark:border-neutral-900/60">
    <div class="container mx-auto px-6 max-w-5xl">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
        {contentData.locations.map((loc) => (
          <div class="group relative flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1 bg-neutral-900/20 border border-neutral-800 rounded-2xl p-6 hover:border-primary/40 hover:shadow-2xl hover:shadow-primary/5">
            <div class="space-y-3">
              <div class="flex items-center gap-2 text-primary">
                <i class="fa-solid fa-location-dot"></i>
                <h3 class="text-lg font-bold text-white tracking-tight">{loc.name}</h3>
              </div>
              <p class="text-neutral-400 text-sm leading-relaxed">{loc.intro}</p>
            </div>

            <div class="mt-6 pt-4 border-t border-neutral-800 flex items-center justify-between">
              <a
                href={`/locations/${loc.slug}`}
                class="text-xs font-extrabold uppercase tracking-widest text-primary hover:text-accent transition-colors flex items-center gap-1.5"
              >
                Local Services <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner (shared component) -->
  <CTA />
</MainLayout>
