---
// Leaf page of the location hub-and-spoke: one page per service x city
// combination, e.g. "Tree Removal in Franklin, TN". Content is assembled
// from real per-city facts (locations.json) and real per-service detail
// (content.json) combined through one of three rotating paragraph
// structures, so no two pages read as a straight find-and-replace of each
// other even where the underlying facts are the same.
import MainLayout from '../../../layouts/MainLayout.astro';
import locationsData from '../../../data/locations.json';
import contentData from '../../../data/content.json';
import businessData from '../../../data/business.json';
import FAQ from '../../../components/FAQ.astro';

export async function getStaticPaths() {
 const paths = [];
 locationsData.forEach((loc, locIndex) => {
 contentData.services.forEach((service, serviceIndex) => {
 paths.push({
 params: { location: loc.slug, service: service.slug },
 props: { loc, service, locIndex, serviceIndex },
 });
 });
 });
 return paths;
}

const { loc, service, locIndex, serviceIndex } = Astro.props;

const templateVariant = (locIndex + serviceIndex) % 3;
const serviceLower = service.title.toLowerCase();

let paragraphs;
if (templateVariant === 0) {
 paragraphs = [
 loc.character,
 loc.angle,
 `If you need ${serviceLower} in ${loc.name}, that's exactly the kind of property ${businessData.name} works on every week. ${service.shortDescription}`,
 ];
} else if (templateVariant === 1) {
 paragraphs = [
 service.longDescription,
 `That's what comes up most in ${loc.name} specifically. ${loc.angle}`,
 loc.character,
 ];
} else {
 paragraphs = [
 `Need ${serviceLower} in ${loc.name}, TN? ${service.shortDescription}`,
 loc.character,
 loc.angle,
 ];
}

// Nearby cities for the same service, and other services in the same city -
// internal links that reinforce the hub-and-spoke structure both ways.
const nearbyForService = [
 locationsData[(locIndex + 1) % locationsData.length],
 locationsData[(locIndex + 2) % locationsData.length],
 locationsData[(locIndex + 3) % locationsData.length],
];
const otherServicesHere = contentData.services.filter((s) => s.slug !== service.slug);

const title = `${service.title} in ${loc.name}, TN | ${businessData.name}`;
const description = `${service.title} in ${loc.name}, TN (${loc.county}). ${service.shortDescription} Licensed and insured, free estimates - call ${businessData.phone}.`;

const breadcrumbSchema = {
 "@context": "https://schema.org",
 "@type": "BreadcrumbList",
 "itemListElement": [
 { "@type": "ListItem", "position": 1, "name": "Locations", "item": new URL('/locations', Astro.site).href },
 { "@type": "ListItem", "position": 2, "name": loc.name, "item": new URL(`/locations/${loc.slug}`, Astro.site).href },
 { "@type": "ListItem", "position": 3, "name": service.title, "item": new URL(`/locations/${loc.slug}/${service.slug}`, Astro.site).href }
 ]
};
---

<MainLayout title={title} description={description}>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
 <!-- Hero -->
 <section
 class="relative py-20 lg:py-28 bg-neutral-900 text-white overflow-hidden bg-cover bg-center"
 style={service.image ? `background-image: linear-gradient(to bottom, rgba(24, 24, 27, 0.75), rgba(24, 24, 27, 0.92)), url('${service.image}');` : ''}
 >
 <div class="container mx-auto px-6 relative z-10 max-w-4xl space-y-4">
 <nav class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-neutral-400 mb-2" aria-label="Breadcrumb">
 <a href="/locations" class="hover:text-accent transition-colors">Locations</a>
 <span>/</span>
 <a href={`/locations/${loc.slug}`} class="hover:text-accent transition-colors">{loc.name}</a>
 <span>/</span>
 <span class="text-accent">{service.title}</span>
 </nav>
 <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-tight">
 {service.title} in {loc.name}, TN
 </h1>
 <p class="text-lg md:text-xl text-neutral-300 font-normal leading-relaxed max-w-2xl">
 {service.shortDescription}
 </p>
 <div class="pt-4">
 <a href={`tel:${businessData.phone}`} class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-neutral-950 bg-white hover:bg-neutral-100 rounded-custom shadow-lg transition-all hover:scale-103">
 Call Now: {businessData.phone}
 </a>
 </div>
 </div>
 </section>

 <!-- Local content -->
 <section class="py-24 bg-white">
 <div class="container mx-auto px-6 max-w-5xl">
 <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

 <div class="lg:col-span-7 space-y-6">
 <h2 class="text-3xl font-extrabold text-neutral-900">
 {service.title} for {loc.name} Properties
 </h2>
 {paragraphs.map((p) => (
 <p class="text-neutral-600 text-base leading-relaxed">{p}</p>
 ))}
 </div>

 <div class="lg:col-span-5 p-8 rounded-custom bg-neutral-50 border border-neutral-200/50 space-y-6">
 <h3 class="font-bold text-lg text-neutral-900 border-b border-neutral-200/50 pb-3">
 What's Included
 </h3>
 <ul class="space-y-4 font-semibold text-sm text-neutral-700">
 {service.features.map((feature) => (
 <li class="flex items-center gap-3">
 <span class="w-6 h-6 rounded-custom bg-primary/10 text-primary flex items-center justify-center text-xs shrink-0">&check;</span>
 {feature}
 </li>
 ))}
 </ul>
 <div class="pt-4">
 <a href={`tel:${businessData.phone}`} class="block text-center px-4 py-3 font-bold text-white bg-primary hover:bg-primary-hover rounded-custom shadow-md transition-all">
 Call Us: {businessData.phone}
 </a>
 </div>
 </div>
 </div>

 <!-- Internal links: other services here, nearby cities for this service -->
 <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mt-16 pt-16 border-t border-neutral-100">
 <div class="space-y-3">
 <h3 class="text-sm font-bold uppercase tracking-wider text-neutral-500">
 Other Services in {loc.name}
 </h3>
 <ul class="space-y-2">
 {otherServicesHere.map((s) => (
 <li>
 <a href={`/locations/${loc.slug}/${s.slug}`} class="text-neutral-700 hover:text-primary transition-colors text-sm font-semibold">
 {s.title} in {loc.name} &rarr;
 </a>
 </li>
 ))}
 </ul>
 </div>
 <div class="space-y-3">
 <h3 class="text-sm font-bold uppercase tracking-wider text-neutral-500">
 {service.title} Near {loc.name}
 </h3>
 <ul class="space-y-2">
 {nearbyForService.map((n) => (
 <li>
 <a href={`/locations/${n.slug}/${service.slug}`} class="text-neutral-700 hover:text-primary transition-colors text-sm font-semibold">
 {service.title} in {n.name} &rarr;
 </a>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </div>
 </section>

 <!-- Service FAQ -->
 {service.faq && service.faq.length > 0 && (
 <FAQ faqsOverride={service.faq} />
 )}
</MainLayout>
