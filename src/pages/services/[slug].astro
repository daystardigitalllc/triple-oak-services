---
import MainLayout from '../../layouts/MainLayout.astro';
import contentData from '../../data/content.json';
import businessData from '../../data/business.json';
import FAQ from '../../components/FAQ.astro';

export async function getStaticPaths() {
  return contentData.services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<MainLayout 
  title={`${service.title} | ${businessData.name}`}
  description={service.shortDescription}
>
  <!-- Service Hero Section -->
  <section
    class="relative py-20 lg:py-28 bg-neutral-900 text-white overflow-hidden bg-cover bg-center"
    style={service.image ? `background-image: linear-gradient(to bottom, rgba(15, 12, 8, 0.75), rgba(15, 12, 8, 0.9)), url('${service.image}');` : ''}
  >
    <div class="container mx-auto px-6 relative z-10 text-center max-w-4xl space-y-6">
      <a href="/" class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-accent hover:text-white transition-colors mb-2">
        &larr; Back to Home
      </a>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-tight">
        {service.title}
      </h1>
      <p class="text-lg md:text-xl text-neutral-300 font-normal leading-relaxed max-w-2xl mx-auto">
        {service.shortDescription}
      </p>
      <div class="pt-4">
        <a href={`tel:${businessData.phone}`} class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-neutral-950 bg-white hover:bg-neutral-100 rounded-custom shadow-lg transition-all hover:scale-103">
          Call Now: {businessData.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- Detailed Service Description -->
  <section class="py-24 bg-white dark:bg-neutral-950">
    <div class="container mx-auto px-6 max-w-5xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Long Description -->
        <div class="lg:col-span-7 space-y-6">
          <h2 class="text-3xl font-extrabold text-neutral-900 dark:text-white">
            The Details
          </h2>
          <p class="text-neutral-600 dark:text-neutral-400 text-base leading-relaxed">
            {service.longDescription}
          </p>
          <div class="p-6 rounded-custom bg-neutral-50 dark:bg-neutral-900 border border-neutral-100 dark:border-neutral-800">
            <h4 class="font-bold text-neutral-900 dark:text-white mb-2">Why Call {businessData.name}</h4>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">
              Licensed and insured, and we clear out every branch and log before we call the job done.
            </p>
          </div>
        </div>

        <!-- Features Sidebar -->
        <div class="lg:col-span-5 glass-panel p-8 rounded-custom bg-neutral-50 dark:bg-neutral-900 border border-neutral-200/50 dark:border-neutral-800/50 space-y-6">
          <h3 class="font-bold text-lg text-neutral-900 dark:text-white border-b border-neutral-200/50 dark:border-neutral-800/50 pb-3">
            Service Highlights
          </h3>
          <ul class="space-y-4 font-semibold text-sm text-neutral-700 dark:text-neutral-300">
            {service.features.map((feature) => (
              <li class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xs shrink-0">&check;</span>
                {feature}
              </li>
            ))}
          </ul>
          <div class="pt-4">
            <a href={`tel:${businessData.phone}`} class="block text-center px-4 py-3 font-bold text-white bg-primary hover:bg-primary-hover rounded-custom shadow-md transition-all">
              Call Us: {businessData.phone}
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Service Specific FAQ -->
  {service.faq && service.faq.length > 0 && (
    <FAQ faqsOverride={service.faq} />
  )}
</MainLayout>
