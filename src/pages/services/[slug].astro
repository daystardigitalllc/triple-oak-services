---
import MainLayout from '../../layouts/MainLayout.astro';
import contentData from '../../data/content.json';
import businessData from '../../data/business.json';
import locationsData from '../../data/locations.json';
import FAQ from '../../components/FAQ.astro';

export async function getStaticPaths() {
  return contentData.services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": service.title,
  "name": `${service.title} | ${businessData.name}`,
  "description": service.shortDescription,
  "provider": {
    "@type": "LocalBusiness",
    "name": businessData.name,
    "telephone": businessData.phone
  },
  "areaServed": (businessData.locations || []).map((city) => ({ "@type": "City", "name": city }))
};

---

<MainLayout
  title={`${service.title} in Middle Tennessee | ${businessData.name}`}
  description={`${service.shortDescription} Serving Nashville, Franklin, Murfreesboro, and ${locationsData.length - 3} more Middle Tennessee communities. Call ${businessData.phone} for a free quote.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <!-- Service Hero Section -->
  <section
    class="relative py-20 lg:py-28 bg-neutral-900 text-white overflow-hidden bg-cover bg-center"
    style={service.image ? `background-image: linear-gradient(to bottom, rgba(24, 24, 27, 0.75), rgba(24, 24, 27, 0.9)), url('${service.image}');` : ''}
  >
    <div class="container mx-auto px-6 relative z-10 text-center max-w-4xl space-y-6">
      <a href="/" class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-accent hover:text-white transition-colors mb-2">
        &larr; Back to Home
      </a>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-tight">
        {service.title}
      </h1>
      <p class="text-lg md:text-xl text-neutral-300 font-normal leading-relaxed max-w-2xl mx-auto">
        {service.shortDescription}
      </p>
      <div class="pt-4">
        <a href={`tel:${businessData.phone}`} class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-neutral-950 bg-white hover:bg-neutral-100 rounded-custom shadow-lg transition-all hover:scale-103">
          Call Now: {businessData.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- Detailed Service Description -->
  <section class="py-24 bg-white dark:bg-neutral-950">
    <div class="container mx-auto px-6 max-w-5xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Long Description -->
        <div class="lg:col-span-7 space-y-6">
          <h2 class="text-3xl font-extrabold text-neutral-900 dark:text-white">
            The Details
          </h2>
          <p class="text-neutral-600 dark:text-neutral-400 text-base leading-relaxed">
            {service.longDescription}
          </p>
          <div class="p-6 rounded-custom bg-neutral-50 dark:bg-neutral-900 border border-neutral-100 dark:border-neutral-800">
            <h4 class="font-bold text-neutral-900 dark:text-white mb-2">Why Call {businessData.name}</h4>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">
              Licensed and insured, and we clear out every branch and log before we call the job done.
            </p>
          </div>
        </div>

        <!-- Features Sidebar -->
        <div class="lg:col-span-5 glass-panel p-8 rounded-custom bg-neutral-50 dark:bg-neutral-900 border border-neutral-200/50 dark:border-neutral-800/50 space-y-6">
          <h3 class="font-bold text-lg text-neutral-900 dark:text-white border-b border-neutral-200/50 dark:border-neutral-800/50 pb-3">
            Service Highlights
          </h3>
          <ul class="space-y-4 font-semibold text-sm text-neutral-700 dark:text-neutral-300">
            {service.features.map((feature) => (
              <li class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-custom bg-primary/10 text-primary flex items-center justify-center text-xs shrink-0">&check;</span>
                {feature}
              </li>
            ))}
          </ul>
          <div class="pt-4">
            <a href={`tel:${businessData.phone}`} class="block text-center px-4 py-3 font-bold text-white bg-primary hover:bg-primary-hover rounded-custom shadow-md transition-all">
              Call Us: {businessData.phone}
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Signals: when to consider this service -->
  {service.signals && service.signals.length > 0 && (
    <section class="py-20 bg-neutral-50 dark:bg-neutral-900/40 border-t border-neutral-100 dark:border-neutral-900/60">
      <div class="container mx-auto px-6 max-w-4xl">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-neutral-900 dark:text-white text-center mb-10">
          Signs You Need {service.title}
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {service.signals.map((signal) => (
            <li class="flex items-start gap-3 p-4 rounded-custom bg-white dark:bg-neutral-900 border border-neutral-100 dark:border-neutral-800">
              <i class="fa-solid fa-triangle-exclamation text-accent mt-1 shrink-0"></i>
              <span class="text-sm text-neutral-700 dark:text-neutral-300 font-medium">{signal}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Process: how it works -->
  {service.process && service.process.length > 0 && (
    <section class="py-20 bg-white dark:bg-neutral-950 border-t border-neutral-100 dark:border-neutral-900/60">
      <div class="container mx-auto px-6 max-w-4xl">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-neutral-900 dark:text-white text-center mb-10">
          How It Works
        </h2>
        <ol class="space-y-6">
          {service.process.map((step, i) => (
            <li class="flex items-start gap-5">
              <span class="w-9 h-9 rounded-custom bg-primary text-neutral-950 font-extrabold flex items-center justify-center shrink-0">{i + 1}</span>
              <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed pt-1">{step}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- Available in every service area -->
  <section class="py-16 bg-neutral-50 dark:bg-neutral-900/40 border-t border-neutral-100 dark:border-neutral-900/60">
    <div class="container mx-auto px-6 max-w-4xl text-center space-y-6">
      <h2 class="text-sm font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
        {service.title} Available Across Middle Tennessee
      </h2>
      <div class="flex flex-wrap justify-center gap-3">
        {locationsData.map((loc) => (
          <a href={`/locations/${loc.slug}/${service.slug}`} class="px-4 py-2 rounded-custom text-sm font-semibold bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300 hover:border-primary/40 hover:text-primary transition-all">
            {loc.name}, TN
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Service Specific FAQ -->
  {service.faq && service.faq.length > 0 && (
    <FAQ faqsOverride={service.faq} />
  )}
</MainLayout>
