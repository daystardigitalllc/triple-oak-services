---
// src/pages/services/index.astro
// Services Hub Page - lists and links to every service detail page.
import MainLayout from '../../layouts/MainLayout.astro';
import businessData from '../../data/business.json';
import Services from '../../components/Services.astro';
import CTA from '../../components/CTA.astro';
---

<MainLayout
  title={`Tree Services in Middle Tennessee | ${businessData.name}`}
  description={`Tree trimming, removal, stump grinding, storm cleanup, and land clearing from ${businessData.name}. Licensed and insured, serving Nashville and the surrounding Middle Tennessee area.`}
>
  <!-- Hero Banner -->
  <section class="relative pt-32 pb-20 lg:pt-40 lg:pb-24 bg-neutral-950 text-white overflow-hidden text-center select-none">
    <div class="container mx-auto px-6 relative z-10 max-w-3xl space-y-6">
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight uppercase leading-[1.1] text-white">
        What We Handle
      </h1>
      <p class="text-base sm:text-lg text-neutral-300 max-w-xl mx-auto leading-relaxed">
        Five services, one crew: trimming, removal, stump grinding, storm cleanup, and land clearing across Middle Tennessee.
      </p>
    </div>
  </section>

  <!-- Services Grid (shared component) -->
  <Services />

  <!-- CTA Banner (shared component) -->
  <CTA />
</MainLayout>
