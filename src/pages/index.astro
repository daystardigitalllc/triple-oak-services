---

<MainLayout>
  {layout.map((componentName) => {
    const Component = ComponentMap[componentName];
    if (!Component) {
      console.warn(`Component "${componentName}" was listed in layout but not found in ComponentMap.`);
      return null;
    }
    return <Component />;
  })}
</MainLayout>
