---
import MainLayout from '../layouts/MainLayout.astro';
import contentData from '../data/content.json';

// The site only ever renders these 11 sections (see content.json's
// "layout" array). This used to import the entire ~80-component template
// library "just in case" a name in that array matched one - dead weight
// that dragged in unused dependencies (embla-carousel, the @data-slot/*
// package set, etc.) for components that never render. Import only what
// this site actually uses.
import Hero from '../components/Hero.astro';
import QuickQuoteBarSection from '../components/QuickQuoteBarSection.astro';
import Marquee from '../components/Marquee.astro';
import TrustBar from '../components/TrustBar.astro';
import Services from '../components/Services.astro';
import CTA from '../components/CTA.astro';
import Reviews from '../components/Reviews.astro';
import GalleryScrollChoreography from '../components/GalleryScrollChoreography.astro';
import CompareSlider from '../components/CompareSlider.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import FAQ from '../components/FAQ.astro';
import QuoteFunnel from '../components/QuoteFunnel.astro';

const ComponentMap: Record<string, any> = {
  Hero,
  QuickQuoteBarSection,
  Marquee,
  TrustBar,
  Services,
  CTA,
  Reviews,
  GalleryScrollChoreography,
  CompareSlider,
  ServiceAreas,
  FAQ,
  QuoteFunnel,
};

const layout: string[] = contentData.layout || [];
---

<MainLayout>
  {layout.map((componentName) => {
    const Component = ComponentMap[componentName];
    if (!Component) {
      console.warn(`Component "${componentName}" was listed in layout but not found in ComponentMap.`);
      return null;
    }
    return <Component />;
  })}
</MainLayout>
