---
type Props = {
  class?: string
  title?: string
  description?: string
  brands: {
    name: string
    href?: string
  }[]
}

const { class: className, title, description, brands } = Astro.props
---

<section class:list={["relative flex scroll-mt-12 flex-col gap-16 py-16 bg-background w-full", className]} data-slot="section">
  {
    (title || description) && (
      <div class="relative mx-auto flex w-full max-w-7xl flex-col gap-8 px-4 items-center gap-4 text-center">
        {title && (
          <h2 class="text-foreground text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
            {title}
          </h2>
        )}
        {description && (
          <p class="text-muted-foreground max-w-2xl text-lg leading-relaxed text-balance">
            {description}
          </p>
        )}
      </div>
    )
  }

  <div
    data-marquee
    class="relative w-full group flex gap-[3rem] overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)] [-webkit-mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)] text-muted-foreground"
    style="--duration: 30s; --gap: 3rem;"
  >
    <div class="marquee-content flex min-w-full shrink-0 justify-around gap-[var(--gap)] will-change-transform animate-[marquee-x_var(--duration,20s)_linear_infinite] motion-reduce:[animation-play-state:paused]">
      {
        brands.map((brand) => {
          const Comp = brand.href ? "a" : "div";
          return (
            <Comp
              class="flex h-10 items-center justify-start gap-2 text-base font-semibold whitespace-nowrap hover:text-foreground grayscale transition-all hover:grayscale-0"
              href={brand.href}
            >
              <span class="text-lg">{brand.name}</span>
            </Comp>
          )
        })
      }
    </div>
    <div class="marquee-content flex min-w-full shrink-0 justify-around gap-[var(--gap)] will-change-transform animate-[marquee-x_var(--duration,20s)_linear_infinite] motion-reduce:[animation-play-state:paused]" aria-hidden="true">
      {
        brands.map((brand) => {
          const Comp = brand.href ? "a" : "div";
          return (
            <Comp
              class="flex h-10 items-center justify-start gap-2 text-base font-semibold whitespace-nowrap hover:text-foreground grayscale transition-all hover:grayscale-0"
              href={brand.href}
            >
              <span class="text-lg">{brand.name}</span>
            </Comp>
          )
        })
      }
    </div>
  </div>
</section>

<style>
  @keyframes marquee-x {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-100% - var(--gap)));
    }
  }

  .group:hover .marquee-content {
    animation-play-state: paused;
  }
</style>
