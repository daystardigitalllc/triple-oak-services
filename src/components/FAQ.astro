---
import contentData from '../data/content.json';

interface Props {
  faqsOverride?: { q: string; a: string }[];
}

const { faqsOverride } = Astro.props;
const faqs = faqsOverride || contentData.faqs;

const faqSchema = faqs && faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
} : null;
---
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

<section id="faq" class="py-24 bg-white relative border-t border-neutral-100">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">

      {/* Left Column Header */}
      <div class="lg:col-span-4 space-y-6 text-left self-start lg:sticky lg:top-32">
        <span class="text-xs font-bold uppercase tracking-wider text-primary bg-primary/10 px-3.5 py-1.5 rounded-md border border-primary/20">
          Got Questions?
        </span>
        <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-neutral-900 uppercase leading-[1.1]">
          Questions,<br>Answered
        </h2>
        <p class="text-base text-neutral-500 font-normal leading-relaxed">
          Don't see your question here? Give us a call and we'll walk you through it.
        </p>
        <div class="pt-2">
          <a href="#quote-funnel" class="inline-flex items-center justify-center px-6 py-3.5 rounded-custom text-xs font-bold uppercase tracking-widest transition-all hover:scale-102 text-primary bg-transparent border-2 border-primary hover:bg-primary hover:text-white">
            Get an Estimate
          </a>
        </div>
      </div>

      {/* Right Column Accordions */}
      <div class="lg:col-span-8 space-y-4">
        {faqs.map((faq) => (
          <details class="bg-neutral-50 group rounded-custom border border-neutral-200 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex justify-between items-center p-6 font-bold text-neutral-900 cursor-pointer select-none">
              <span class="text-base sm:text-lg uppercase tracking-tight">{faq.q}</span>
              <span class="ml-4 shrink-0 rounded-full bg-primary/10 text-primary p-1.5 transition-transform duration-300 group-open:-rotate-180">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-6 pt-0 border-t border-neutral-200/60">
              <p class="text-sm sm:text-base text-neutral-600 leading-relaxed pt-4 font-normal">
                {faq.a}
              </p>
            </div>
          </details>
        ))}
      </div>

    </div>
  </div>
</section>
