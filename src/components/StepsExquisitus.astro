---
// StepsExquisitus.astro
// Chronological step list guide matching the Exquisitus documentation styling.
// Renders numeric circles aligned by a connecting guide line that fades out gracefully.

interface StepItem {
  title: string;
  description: string;
}

interface Props {
  steps?: StepItem[];
  class?: string;
}

const {
  steps,
  class: className = ''
} = Astro.props;

const defaultSteps: StepItem[] = [
  {
    title: 'Initialize Theme config',
    description: 'Configure your integration parameters inside the astro config.mjs properties.'
  },
  {
    title: 'Install dependencies',
    description: 'Run standard command package additions via pnpm or npm to sync version hooks.'
  },
  {
    title: 'Power on dev server',
    description: 'Spin up the local developer instance and audit scroll triggers and viewport entries.'
  }
];

const items = steps || defaultSteps;
---

<div class:list={["relative select-none", className]}>
  <!-- Left connection guideline (fades out at bottom) -->
  <div class="absolute left-6 top-8 bottom-8 w-0.5 bg-gradient-to-b from-neutral-200 via-neutral-200 to-transparent dark:from-neutral-850 dark:via-neutral-850 dark:to-transparent -z-10"></div>

  <!-- Steps List -->
  <div class="space-y-12">
    {items.map((item, idx) => (
      <div class="flex items-start gap-6 relative">
        <!-- Circular counter numeral -->
        <div class="w-12 h-12 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950 flex items-center justify-center font-mono font-bold text-neutral-900 dark:text-neutral-100 shadow-sm shrink-0">
          {idx + 1}
        </div>

        <!-- Copy Block -->
        <div class="pt-2 space-y-2 text-left">
          <h3 class="text-base font-bold text-neutral-950 dark:text-white tracking-tight">{item.title}</h3>
          <p class="text-neutral-500 dark:text-neutral-400 text-xs sm:text-sm leading-relaxed max-w-lg">{item.description}</p>
        </div>
      </div>
    ))}
  </div>
</div>
