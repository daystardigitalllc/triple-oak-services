---
// NavbarPill.astro
// Floating pill-shaped navbar — a lighter, more modern alternative to
// Header.astro. Concept inspired by the "Navbar Pill" style in
// Aceternity UI's navbar collection, rebuilt from scratch in Astro +
// Tailwind (no React/framer-motion). Fixed at the top of the viewport,
// so pages using it should add top padding to their first section
// (e.g. `pt-28`) to avoid content sliding underneath it.
import businessData from '../data/business.json';
import contentData from '../data/content.json';

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  navLinksOverride?: NavLink[];
  ctaTextOverride?: string;
  ctaHrefOverride?: string;
}

const { navLinksOverride, ctaTextOverride, ctaHrefOverride } = Astro.props;

const links: NavLink[] = navLinksOverride || contentData.navbarPill?.links || [];
const ctaText = ctaTextOverride || businessData.mainCta || 'Get a Quote';
const ctaHref = ctaHrefOverride || '#quote-funnel';

const uid = `navpill-${Math.random().toString(36).slice(2, 9)}`;
---

<header data-navpill-id={uid} class="fixed top-4 inset-x-0 z-50 px-4">
  <div class="mx-auto max-w-3xl">
    <nav
      data-navpill-bar
      class="flex items-center gap-1 rounded-full border border-slate-200/70 dark:border-slate-800/70 bg-white/85 dark:bg-slate-950/85 backdrop-blur-md shadow-md shadow-slate-900/5 pl-3 pr-2 py-2 transition-shadow duration-300"
    >
      <a href="/" class="flex items-center gap-2 shrink-0 pr-2">
        {businessData.logo && businessData.logo !== '/logo.svg' && businessData.logo !== '' ? (
          <img src={businessData.logo} alt={`${businessData.name} Logo`} class="h-8 w-8 rounded-full object-cover border border-slate-200/50 bg-white shadow-sm shrink-0" />
        ) : (
          <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white font-extrabold text-xs shrink-0">
            {businessData.name.charAt(0)}
          </div>
        )}
        <span class="hidden sm:inline font-bold text-sm text-slate-900 dark:text-white tracking-tight">
          {businessData.name}
        </span>
      </a>

      <div class="hidden md:flex items-center gap-0.5 mx-auto">
        {links.map((link) => (
          <a
            href={link.href}
            class="px-3 py-1.5 rounded-full text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>

      <a
        href={ctaHref}
        class="hidden md:inline-flex items-center justify-center ml-auto px-4 py-2 rounded-full text-sm font-semibold text-white bg-primary hover:bg-primary-hover transition-colors shrink-0"
      >
        {ctaText}
      </a>

      <button
        type="button"
        data-navpill-toggle
        class="md:hidden ml-auto p-2 rounded-full text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800"
        aria-label="Toggle menu"
      >
        <i class="fa-solid fa-bars text-sm"></i>
      </button>
    </nav>

    <div
      data-navpill-menu
      class="hidden mt-2 rounded-2xl border border-slate-200/70 dark:border-slate-800/70 bg-white/95 dark:bg-slate-950/95 backdrop-blur-md shadow-lg p-3 flex flex-col gap-1"
    >
      {links.map((link) => (
        <a href={link.href} class="px-4 py-2 rounded-xl text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
          {link.label}
        </a>
      ))}
      <a href={ctaHref} class="mt-1 px-4 py-2.5 rounded-xl text-sm font-semibold text-center text-white bg-primary">
        {ctaText}
      </a>
    </div>
  </div>
</header>

<script define:vars={{ uid }}>
  (() => {
    const root = document.querySelector(`[data-navpill-id="${uid}"]`);
    if (!root) return;

    const bar = root.querySelector('[data-navpill-bar]');
    const toggle = root.querySelector('[data-navpill-toggle]');
    const menu = root.querySelector('[data-navpill-menu]');

    toggle?.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });

    const onScroll = () => {
      bar.classList.toggle('shadow-lg', window.scrollY > 10);
      bar.classList.toggle('shadow-md', window.scrollY <= 10);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
