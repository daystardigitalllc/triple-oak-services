---
// PlansThreeTier.astro
// Three-tier service plan comparison cards matching the WordPress mockup colors:
// Gold, Red, and Dark Grey accent banners, detailed checklists, and request CTAs.
import contentData from '../data/content.json';

interface Plan {
  id: string;
  name: string;
  price: string;
  period: string;
  colorType: 'gold' | 'red' | 'grey';
  description: string;
  features: string[];
  ctaText?: string;
  ctaHref?: string;
}

interface Props {
  badgeOverride?: string;
  headingOverride?: string;
  plansOverride?: Plan[];
}

const {
  badgeOverride,
  headingOverride,
  plansOverride
} = Astro.props;

const data = contentData.home?.plansThreeTier;

const badge = badgeOverride || data?.badge || 'PLANS & PRICING';
const heading = headingOverride || data?.title || 'Our Service Plans';

const defaultPlans: Plan[] = [
  {
    id: 'basic',
    name: 'DOA Basic',
    price: '39',
    period: 'mo',
    colorType: 'gold',
    description: 'Essential seasonal coverage for common residential pests.',
    features: [
      'Coverage for Ants, Roaches & Spiders',
      'Exterior Perimeter Boundary Sprays',
      'Bi-Annual Scheduled Service Tune-ups',
      'Standard Email & Phone Dispatch Support',
      'Termite Mapping (Available as Addon)'
    ],
    ctaText: 'Choose Basic',
    ctaHref: '#contacts'
  },
  {
    id: 'shield',
    name: 'DOA Shield Plus',
    price: '59',
    period: 'mo',
    colorType: 'red',
    description: 'Our most popular comprehensive home protection system.',
    features: [
      'All Basic Plan Covered Pests',
      'Interior Target Crack & Crevice Sprays',
      'Quarterly Scheduled Service Tune-ups',
      'Unlimited Free Re-Treatments Guarantee',
      '24/7 Priority Emergency Storm Dispatch'
    ],
    featuresHighlights: true,
    colorHighlight: 'bg-red-650',
    ctaText: 'Choose Shield Plus',
    ctaHref: '#contacts'
  },
  {
    id: 'elite',
    name: 'DOA Elite',
    price: '99',
    period: 'mo',
    colorType: 'grey',
    description: 'Complete yard, structure, and foundation security.',
    features: [
      'All Shield Plan Covered Pests',
      'Complete Yard Mosquito Protection sprays',
      'Termite Baiting System Assembly & map',
      'Dedicated Customer Account Manager',
      'Same-Day Priority Tech Dispatch Lines'
    ],
    ctaText: 'Choose Elite',
    ctaHref: '#contacts'
  }
];

const plans = plansOverride || data?.plans || defaultPlans;

const colorStyles = {
  gold: {
    banner: 'bg-amber-600 text-white',
    border: 'border-amber-600/40 hover:border-amber-600',
    text: 'text-amber-700'
  },
  red: {
    banner: 'bg-red-650 text-white',
    border: 'border-red-650/40 hover:border-red-650',
    text: 'text-red-650'
  },
  grey: {
    banner: 'bg-slate-700 text-white',
    border: 'border-slate-700/40 hover:border-slate-700',
    text: 'text-slate-700'
  }
};
---

<section id="plans" class="py-24 bg-white dark:bg-slate-950 text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-800 select-none">
  <div class="container mx-auto px-6 max-w-5xl space-y-16">
    
    <!-- Header -->
    <div class="max-w-xl mx-auto text-center space-y-2">
      {badge && (
        <span class="text-xs font-bold uppercase tracking-wider text-red-600">
          {badge}
        </span>
      )}
      <h2 class="text-3xl sm:text-4.5xl font-black text-slate-950 dark:text-white tracking-tight leading-tight">
        {heading}
      </h2>
    </div>

    <!-- 3 plans comparison grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch pt-4">
      {plans.map((plan) => {
        const config = colorStyles[plan.colorType] || colorStyles.grey;
        return (
          <div class:list={[
            "bg-white dark:bg-slate-900 border-2 rounded-2xl overflow-hidden shadow-lg flex flex-col justify-between transition-all duration-300 transform hover:-translate-y-1 pb-8",
            config.border
          ]}>
            
            <!-- Plan Header Title Banner -->
            <div class:list={["px-6 py-5 text-center space-y-1.5 select-none", config.banner]}>
              <h3 class="text-lg font-black uppercase tracking-wider">{plan.name}</h3>
              <p class="text-[10px] font-bold opacity-80 uppercase tracking-widest">{plan.description}</p>
            </div>

            <!-- Price -->
            <div class="py-8 text-center border-b border-slate-100 dark:border-slate-800">
              <span class="flex items-baseline justify-center">
                <span class="text-2xl font-bold text-slate-400 mr-0.5">$</span>
                <span class="text-5.5xl font-black tracking-tight text-slate-900 dark:text-white">{plan.price}</span>
                <span class="text-sm font-bold text-slate-400 ml-1">/{plan.period}</span>
              </span>
            </div>

            <!-- Features Checklist -->
            <ul class="flex-grow space-y-4 px-8 py-8 text-xs sm:text-sm text-slate-650 dark:text-slate-300 font-semibold text-left">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2.5">
                  <span class:list={["font-black text-base select-none shrink-0 mt-[-1px]", config.text]}>&bull;</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <!-- Button selection action -->
            <div class="px-8 pt-2">
              <a 
                href={plan.ctaHref || "#contacts"} 
                class:list={[
                  "block w-full py-3 text-center text-xs font-black uppercase tracking-widest transition-all rounded shadow-md border border-slate-200 dark:border-slate-800 cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-850",
                  plan.colorType === 'red' ? 'bg-red-650 text-white hover:bg-red-700 border-red-500/20' : 'bg-white text-slate-900'
                ]}
              >
                {plan.ctaText || 'Get Started'}
              </a>
            </div>

          </div>
        );
      })}
    </div>

  </div>
</section>
