---
// FooterBigText.astro
// Alternative to Footer.astro — a 3-column link footer with a giant,
// faded wordmark of the business name spanning the bottom edge. Concept
// inspired by the "Footer With Big Text" style in Aceternity UI's
// footer collection, rebuilt from scratch in Astro + Tailwind.
import businessData from '../data/business.json';
import contentData from '../data/content.json';

interface Props {
  taglineOverride?: string;
}

const { taglineOverride } = Astro.props;
const tagline = taglineOverride || contentData.footerBigText?.tagline || '';
---

<footer class="relative bg-slate-950 text-slate-400 pt-20 pb-8 border-t border-slate-900 overflow-hidden">
  <div class="container mx-auto px-6 relative z-10">
    {tagline && (
      <p class="text-2xl sm:text-3xl font-bold text-white max-w-xl mb-16 leading-tight">
        {tagline}
      </p>
    )}

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-12 pb-16">
      <div class="space-y-4">
        <h4 class="font-bold text-white text-sm uppercase tracking-wider">Services</h4>
        <ul class="space-y-2 text-sm">
          {contentData.services.map((service) => (
            <li>
              <a href={`/services/${service.slug}`} class="hover:text-white transition-colors">{service.title}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="space-y-4">
        <h4 class="font-bold text-white text-sm uppercase tracking-wider">Locations</h4>
        <ul class="space-y-2 text-sm">
          {businessData.locations.map((loc) => (
            <li>
              <a href={`/locations/${loc.toLowerCase().replace(/ /g, '-')}`} class="hover:text-white transition-colors">{loc}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="space-y-4">
        <h4 class="font-bold text-white text-sm uppercase tracking-wider">Contact</h4>
        <ul class="space-y-3 text-sm">
          <li class="flex items-center gap-2.5">
            <i class="fa-solid fa-phone shrink-0 text-slate-500"></i>
            <a href={`tel:${businessData.phone}`} class="hover:text-white transition-colors">{businessData.phone}</a>
          </li>
          <li class="flex items-center gap-2.5">
            <i class="fa-solid fa-envelope shrink-0 text-slate-500"></i>
            <a href={`mailto:${businessData.email}`} class="hover:text-white transition-colors">{businessData.email}</a>
          </li>
        </ul>
        <div class="flex gap-3 pt-1">
          {businessData.socials?.facebook && (
            <a href={businessData.socials.facebook} class="w-8 h-8 flex items-center justify-center bg-slate-900 hover:bg-primary text-white rounded-lg transition-colors" aria-label="Facebook">
              <i class="fa-brands fa-facebook-f text-xs"></i>
            </a>
          )}
          {businessData.socials?.instagram && (
            <a href={businessData.socials.instagram} class="w-8 h-8 flex items-center justify-center bg-slate-900 hover:bg-primary text-white rounded-lg transition-colors" aria-label="Instagram">
              <i class="fa-brands fa-instagram text-xs"></i>
            </a>
          )}
          {businessData.socials?.google && (
            <a href={businessData.socials.google} class="w-8 h-8 flex items-center justify-center bg-slate-900 hover:bg-primary text-white rounded-lg transition-colors" aria-label="Google Business">
              <i class="fa-brands fa-google text-xs"></i>
            </a>
          )}
        </div>
      </div>
    </div>

    <div class="pt-8 border-t border-slate-900 flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-semibold text-slate-600">
      <p>&copy; {new Date().getFullYear()} {businessData.name}. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-white">Privacy Policy</a>
        <a href="#" class="hover:text-white">Terms of Service</a>
      </div>
    </div>
  </div>

  {/* Giant faded wordmark */}
  <div class="pointer-events-none select-none absolute inset-x-0 bottom-[-0.12em] flex justify-center overflow-hidden" aria-hidden="true">
    <span class="text-[16vw] leading-none font-black text-white/5 whitespace-nowrap">
      {businessData.name}
    </span>
  </div>
</footer>
