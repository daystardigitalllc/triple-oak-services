---
// HeroCozy.astro
// Warm, elegant, centered hero section inspired by premium consumer product designs.
// Features a serif font heading, soft cream lighting, and a large product showcase mockup card.
import businessData from '../data/business.json';
import contentData from '../data/content.json';

interface Props {
  badgeOverride?: string;
  headingOverride?: string;
  subtitleOverride?: string;
  primaryCtaTextOverride?: string;
  primaryCtaHrefOverride?: string;
  imageSrcOverride?: string;
  imageAltOverride?: string;
}

const {
  badgeOverride,
  headingOverride,
  subtitleOverride,
  primaryCtaTextOverride,
  primaryCtaHrefOverride,
  imageSrcOverride,
  imageAltOverride,
} = Astro.props;

const data = contentData.home?.heroCozy || contentData.home?.heroAnimated || contentData.home?.hero;

const badge = badgeOverride || data?.badge || 'Meet your new companion';
const heading = headingOverride || data?.h1 || data?.heading || 'A brighter day is a conversation away.';
const subtitle = subtitleOverride || data?.supporting || data?.subtitle || 'An interactive companion that brings families closer and keeps everyone connected.';
const primaryCtaText = primaryCtaTextOverride || data?.ctaText || data?.primaryCtaText || businessData.mainCta || 'Get Started';
const primaryCtaHref = primaryCtaHrefOverride || data?.primaryCtaHref || '#quote-funnel';
const imageSrc = imageSrcOverride || data?.imageSrc || '/images/hero-cozy-device.jpg';
const imageAlt = imageAltOverride || data?.imageAlt || 'Interactive companion device on a table';
---

<section class="relative pt-20 pb-16 md:pt-32 md:pb-24 bg-[#FAF7F2] text-slate-800 overflow-hidden border-b border-orange-100/50">
  <!-- Soft Radial Background Glow -->
  <div class="absolute inset-0 pointer-events-none opacity-40">
    <div class="absolute top-[-20%] left-[-20%] w-[60%] aspect-square rounded-full bg-orange-200/30 blur-[120px]"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[50%] aspect-square rounded-full bg-amber-100/40 blur-[100px]"></div>
  </div>

  <div class="container mx-auto px-6 max-w-5xl relative z-10 flex flex-col items-center text-center">
    
    <!-- Optional Logo Emblem above title -->
    <div class="mb-8 flex items-center justify-center gap-2 animate-fade-in">
      {businessData.logo && businessData.logo !== '' ? (
        <img src={businessData.logo} alt={businessData.name} class="h-9 w-auto opacity-90" />
      ) : (
        <div class="px-3 py-1 rounded-full border border-orange-200 bg-white/70 text-sm font-semibold text-orange-700 tracking-tight shadow-sm">
          {businessData.name}
        </div>
      )}
    </div>

    <!-- Badge -->
    {badge && (
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-orange-600 bg-orange-50 px-4 py-2 rounded-full border border-orange-100/60 shadow-sm mb-6 animate-fade-in-up">
        {badge}
      </span>
    )}

    <!-- Serif Title -->
    <h1 class="text-4xl sm:text-5xl md:text-6.5xl font-serif font-medium tracking-tight text-[#2B231B] leading-[1.1] max-w-3xl animate-fade-in-up">
      {heading}
    </h1>

    <!-- Supporting Text -->
    {subtitle && (
      <p class="mt-6 max-w-xl text-base sm:text-lg text-slate-600 font-normal leading-relaxed animate-fade-in-up" style="animation-delay: 0.1s;">
        {subtitle}
      </p>
    )}

    <!-- CTA Button -->
    <div class="mt-8 flex flex-col sm:flex-row items-center gap-4 animate-fade-in-up" style="animation-delay: 0.2s;">
      <a
        href={primaryCtaHref}
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-full text-base font-bold text-white bg-orange-600 hover:bg-orange-700 active:bg-orange-800 transition-all hover:scale-102 shadow-md shadow-orange-600/10 cursor-pointer"
      >
        {primaryCtaText}
      </a>
    </div>

    <!-- Product Image Mockup Card (With soft shadow & wooden frame styling) -->
    <div class="mt-14 w-full max-w-3.5xl rounded-3xl overflow-hidden bg-white p-4 border border-orange-100/30 shadow-2xl shadow-orange-950/5 relative animate-fade-in-up" style="animation-delay: 0.3s;">
      <div class="aspect-[16/9] w-full rounded-2xl overflow-hidden bg-slate-100 border border-slate-100 relative group">
        <!-- Main Product Photo -->
        <img 
          src={imageSrc} 
          alt={imageAlt} 
          class="w-full h-full object-cover group-hover:scale-101 transition-transform duration-700" 
          onerror="this.src='https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=1200&q=80'"
        />
        <!-- Inner shadow/overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#2B231B]/15 via-transparent to-transparent"></div>
      </div>
      
      <!-- Scroll indicator notch -->
      <a href="#story-grid" class="absolute bottom-6 left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-white/90 border border-orange-100/50 flex items-center justify-center text-slate-500 hover:text-orange-600 hover:bg-white shadow-sm transition-all focus:outline-none">
        <i class="fa-solid fa-chevron-down text-[10px] animate-bounce"></i>
      </a>
    </div>

  </div>
</section>

<style>
  /* Animations helper class */
  .animate-fade-in {
    opacity: 0;
    animation: fadeIn 0.8s ease-out forwards;
  }
  .animate-fade-in-up {
    opacity: 0;
    transform: translateY(1.2rem);
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes fadeIn {
    to { opacity: 1; }
  }
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
