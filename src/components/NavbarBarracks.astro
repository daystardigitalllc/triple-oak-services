---
// src/components/NavbarBarracks.astro
// Barracks-themed transparent header with centered links and profile/cart actions.
import businessData from '../data/business.json';

interface Link {
  label: string;
  href: string;
  hasDropdown?: boolean;
}

interface Props {
  links?: Link[];
  cartCount?: number;
}

const {
  links = [
    { label: "Shop", href: "#", hasDropdown: true },
    { label: "Streams", href: "#" },
    { label: "Staff", href: "#" },
    { label: "About", href: "#" },
    { label: "Contact", href: "#" }
  ],
  cartCount = 0
} = Astro.props;
---

<header
  id="barracks-nav"
  class="fixed top-0 inset-x-0 z-50 bg-gradient-to-b from-black/80 to-transparent transition-all duration-300 select-none py-4 border-b border-white/5"
>
  <div class="container mx-auto px-6 flex items-center justify-between">
    
    <!-- Logo Left -->
    <a href="/" class="flex items-center gap-2 group shrink-0">
      <!-- Shield Logo SVG -->
      <div class="relative w-10 h-10 flex items-center justify-center bg-transparent border border-red-700/60 rounded-lg group-hover:border-red-500 transition-colors shadow-inner">
        <svg viewBox="0 0 100 100" class="w-7 h-7 text-red-650 drop-shadow-[0_0_8px_rgba(185,28,28,0.6)] group-hover:text-red-500 transition-colors" fill="currentColor">
          <!-- Shield Outer -->
          <path d="M50 5 L90 20 L90 55 C90 75 70 90 50 95 C30 90 10 75 10 55 L10 20 Z" fill="none" stroke="currentColor" stroke-width="6" />
          <!-- Star Center -->
          <polygon points="50,22 58,38 76,41 63,54 66,72 50,63 34,72 37,54 24,41 42,38" />
        </svg>
      </div>
      <div class="hidden md:block">
        <span class="text-sm font-black tracking-widest text-white uppercase block leading-none">WAR BARRACKS</span>
        <span class="text-[9px] font-bold tracking-widest text-red-650 uppercase">GAMING</span>
      </div>
    </a>

    <!-- Center Menu links -->
    <nav class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <div class="relative group">
          <a
            href={link.href}
            class="text-xs font-black uppercase tracking-widest text-slate-300 hover:text-white transition-colors flex items-center gap-1.5 py-2 cursor-pointer"
          >
            {link.label}
            {link.hasDropdown && (
              <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-slate-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="3">
                <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </a>
          
          {link.hasDropdown && (
            <div class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-48 bg-slate-950 border border-slate-800/80 rounded-lg p-2 shadow-2xl opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200">
              <a href="#" class="block px-4 py-2 text-[10px] font-bold text-slate-400 hover:text-white hover:bg-slate-900 rounded-md uppercase tracking-wider">Computers & Systems</a>
              <a href="#" class="block px-4 py-2 text-[10px] font-bold text-slate-400 hover:text-white hover:bg-slate-900 rounded-md uppercase tracking-wider">Apparel & Merch</a>
              <a href="#" class="block px-4 py-2 text-[10px] font-bold text-slate-400 hover:text-white hover:bg-slate-900 rounded-md uppercase tracking-wider">TCG & Cards</a>
            </div>
          )}
        </div>
      ))}
    </nav>

    <!-- Actions Right -->
    <div class="flex items-center gap-4 text-white">
      <!-- Profile Button -->
      <a href="#" aria-label="Profile Account" class="p-2 rounded-lg hover:bg-white/5 transition-colors text-slate-350 hover:text-white shrink-0">
        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </svg>
      </a>

      <!-- Shopping Cart -->
      <a href="#" aria-label="Shopping Cart" class="p-2 rounded-lg hover:bg-white/5 transition-colors text-red-650 hover:text-red-500 shrink-0 relative">
        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1" />
          <circle cx="20" cy="21" r="1" />
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
        </svg>
        <span class="absolute top-1 right-0.5 bg-red-650 text-white text-[8px] font-extrabold w-4 h-4 rounded-full flex items-center justify-center ring-2 ring-slate-950">
          {cartCount}
        </span>
      </a>

      <!-- Mobile Burger -->
      <button
        id="barracks-burger"
        aria-label="Toggle Mobile Menu"
        class="md:hidden p-2 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition-colors cursor-pointer"
      >
        <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Dropdown -->
  <div
    id="barracks-mobile-drawer"
    class="hidden absolute top-full inset-x-0 bg-slate-950 border-b border-slate-900 shadow-2xl px-6 py-6 space-y-4"
  >
    {links.map((link) => (
      <div>
        <a href={link.href} class="block text-xs font-black uppercase tracking-widest text-slate-300 hover:text-white transition-colors">
          {link.label}
        </a>
      </div>
    ))}
  </div>
</header>

<script>
  const nav = document.getElementById('barracks-nav')!;
  const burger = document.getElementById('barracks-burger')!;
  const drawer = document.getElementById('barracks-mobile-drawer')!;

  // Handle Scroll Transparency Transition
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      nav.classList.remove('bg-gradient-to-b', 'from-black/80', 'to-transparent', 'py-4');
      nav.classList.add('bg-slate-950/95', 'backdrop-blur-md', 'py-3', 'shadow-lg');
    } else {
      nav.classList.add('bg-gradient-to-b', 'from-black/80', 'to-transparent', 'py-4');
      nav.classList.remove('bg-slate-950/95', 'backdrop-blur-md', 'py-3', 'shadow-lg');
    }
  });

  // Handle Mobile Toggle
  burger.addEventListener('click', () => {
    drawer.classList.toggle('hidden');
  });
</script>
