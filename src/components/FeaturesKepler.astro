---
// FeaturesKepler.astro
// Staggered neo-brutalist features grid in the Kepler theme style.
// Features slightly rotated cards that stand out on a vibrant orange background,
// popping up with solid offset shadows and clean geometric icons on hover.
import contentData from '../data/content.json';

interface FeatureItem {
  title: string;
  description: string;
  shape: 'triangle' | 'circle' | 'square' | 'ring' | 'asterisk' | 'pill';
  color: 'orange' | 'sky';
}

interface Props {
  badgeOverride?: string;
  headingOverride?: string;
  subtitleOverride?: string;
  featuresOverride?: FeatureItem[];
}

const {
  badgeOverride,
  headingOverride,
  subtitleOverride,
  featuresOverride
} = Astro.props;

const data = contentData.home?.featuresKepler;

const badge = badgeOverride || data?.badge || 'Features';
const heading = headingOverride || data?.title || 'Everything ships in the box';
const subtitle = subtitleOverride || data?.subtitle || 'No plugins to chase, no config rabbit holes. Kepler comes wired and ready.';

const defaultFeatures: FeatureItem[] = [
  {
    title: 'Blazing Fast',
    description: 'Zero-JS by default. Islands only where you need them, so pages load instantly.',
    shape: 'triangle',
    color: 'orange'
  },
  {
    title: 'SEO Baked In',
    description: 'Meta tags, sitemaps, RSS, and OG images generated automatically per page.',
    shape: 'circle',
    color: 'sky'
  },
  {
    title: 'MDX Content',
    description: 'Write posts in Markdown or MDX with typed frontmatter and instant previews.',
    shape: 'square',
    color: 'orange'
  },
  {
    title: 'Dark Mode',
    description: 'A polished light/dark theme with a flicker-free toggle that respects the OS.',
    shape: 'ring',
    color: 'sky'
  },
  {
    title: 'Fully Typed',
    description: 'TypeScript end to end with content collections, so refactors never break links.',
    shape: 'asterisk',
    color: 'orange'
  },
  {
    title: 'Deploy Anywhere',
    description: 'One command to Netlify, Vercel, or Cloudflare. Static or SSR — your call.',
    shape: 'pill',
    color: 'sky'
  }
];

const features = featuresOverride || data?.items || defaultFeatures;
---

<section id="features" class="border-y-4 border-slate-950 bg-gradient-to-br from-orange-400 via-orange-500 to-orange-600 text-slate-950 py-24 select-none">
  <div class="container mx-auto px-6 max-w-6.5xl">
    
    <!-- Section Header -->
    <div class="mx-auto text-center max-w-[640px] mb-16 space-y-3">
      {badge && (
        <span class="text-xs font-bold uppercase tracking-[0.15em] text-white bg-slate-950 px-4 py-1.5 rounded-full shadow-sm">
          {badge}
        </span>
      )}
      <h2 class="text-4xl sm:text-5xl font-black leading-tight tracking-tight text-slate-950">
        {heading}
      </h2>
      {subtitle && (
        <p class="text-slate-800 text-sm sm:text-base leading-relaxed">
          {subtitle}
        </p>
      )}
    </div>

    <!-- Neo-brutalist Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {features.map((item, idx) => (
        <div 
          class:list={[
            "rounded-[22px] border-2 border-slate-950 bg-white p-8 shadow-[5px_5px_0_#0f1e42] transition-all duration-200 hover:-translate-y-1 hover:rotate-0 hover:shadow-[7px_7px_0_#0f1e42] transform",
            idx % 2 === 0 ? "-rotate-1" : "rotate-1"
          ]}
        >
          <!-- Geometric Icon Badge -->
          <div class:list={[
            "w-12 h-12 rounded-xl border border-slate-950 flex items-center justify-center mb-6 shadow-sm",
            item.color === 'orange' ? 'bg-orange-100' : 'bg-blue-100'
          ]}>
            {item.shape === 'triangle' && (
              <span class="w-0 h-0 border-l-[9px] border-r-[9px] border-b-[16px] border-l-transparent border-r-transparent border-b-orange-500"></span>
            )}
            {item.shape === 'circle' && (
              <span class="w-4.5 h-4.5 rounded-full bg-slate-900"></span>
            )}
            {item.shape === 'square' && (
              <span class="w-4.5 h-4.5 rotate-45 rounded bg-orange-500"></span>
            )}
            {item.shape === 'ring' && (
              <span class="w-5 h-5 rounded-full border-4 border-slate-900"></span>
            )}
            {item.shape === 'asterisk' && (
              <span class="text-2xl font-black leading-none text-orange-500 font-sans">✦</span>
            )}
            {item.shape === 'pill' && (
              <span class="w-6 h-3 rounded-full border-[3px] border-slate-900"></span>
            )}
          </div>

          <!-- Content Info -->
          <h3 class="text-xl font-bold text-slate-950 tracking-tight mb-2">{item.title}</h3>
          <p class="text-slate-650 text-xs sm:text-sm leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>
