---
import contentData from '../data/content.json';

const featuredSlug = 'tree-removal';
const orderedServices = [
  ...contentData.services.filter((s) => s.slug === featuredSlug),
  ...contentData.services.filter((s) => s.slug !== featuredSlug),
];
---

<section id="services" class="py-24 bg-white relative border-t border-neutral-100">
  <div class="container mx-auto px-6">
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-16 md:mb-20">
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-neutral-900 uppercase leading-[1.1]">
        Tree Work We Do
      </h2>
      <p class="text-base sm:text-lg text-neutral-500 font-normal">
        Tree care handled by a licensed, experienced crew, tailored to what your property actually needs.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {orderedServices.map((service, index) => (
        <div class:list={[
          "group relative flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1",
          service.slug === featuredSlug ? "lg:col-span-2" : "",
          "bg-white border border-neutral-200 rounded-custom hover:border-primary/40 hover:shadow-2xl hover:shadow-primary/10 shadow-sm"
        ]}>

          {/* Card Image Header */}
          <div class:list={["w-full overflow-hidden relative z-0 shrink-0", service.slug === featuredSlug ? "aspect-[21/9]" : "aspect-video"]}>
            <img src={service.image || `/service-${index + 1}.jpg`} alt={service.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/20 to-transparent z-10"></div>
            {service.slug === featuredSlug && (
              <span class="absolute top-4 left-4 z-20 text-[10px] font-extrabold uppercase tracking-widest text-neutral-950 bg-primary px-3 py-1.5 rounded-custom">
                Most Requested
              </span>
            )}
          </div>

          {/* Card Content Wrapper */}
          <div class="flex flex-col justify-between flex-grow p-6">
            <div class="space-y-4">
              {/* Icon/Number */}
              <div class="w-12 h-12 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold text-lg group-hover:bg-primary group-hover:text-white transition-all">
                {String(index + 1).padStart(2, '0')}
              </div>

              {/* Content */}
              <h3 class="text-2xl font-bold text-neutral-900 group-hover:text-primary transition-colors uppercase tracking-tight">
                {service.title}
              </h3>

              <p class="text-neutral-500 text-sm leading-relaxed font-normal">
                {service.shortDescription}
              </p>

              {/* Features list */}
              <ul class="space-y-2 pt-2 text-xs font-semibold text-neutral-600">
                {service.features.map((feature) => (
                  <li class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>

            {/* Link/Button */}
            <div class="pt-6 mt-6 border-t border-neutral-100">
              <a href={`/services/${service.slug}`} class="inline-flex items-center gap-1.5 text-sm font-bold text-primary group-hover:text-primary-hover hover:gap-2.5 transition-all uppercase tracking-wider">
                Learn More
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
