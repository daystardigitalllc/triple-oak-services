---
import contentData from '../data/content.json';
import themeConfig from '../data/theme.config.json';
---

<section id="services" class="py-24 bg-white dark:bg-slate-950 relative border-t border-slate-100 dark:border-slate-900/60">
  {/* Ambient blobs (disabled for Oak City) */}
  <div class="absolute inset-0 pointer-events-none glow-blob-container" style={themeConfig.style === 'oak-city' ? "display: none;" : ""}>
    <div class="absolute top-1/2 left-1/4 w-[300px] h-[300px] bg-primary/5 rounded-full blur-[100px]"></div>
  </div>

  <div class="container mx-auto px-6">
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-16 md:mb-20">
      <span class="text-xs font-bold uppercase tracking-wider text-primary bg-primary/10 px-3 py-1.5 rounded-full">
        Our Expertise
      </span>
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white uppercase leading-[1.1]">
        Services We Offer
      </h2>
      <p class="text-base sm:text-lg text-slate-500 dark:text-slate-400 font-normal">
        We deliver premium solutions tailored to your property's needs with licensed, expert technicians.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {contentData.services.map((service, index) => (
        <div class:list={[
          "group relative flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1",
          themeConfig.style === 'oak-city' 
            ? "bg-slate-900/20 border border-slate-800 rounded-2xl hover:border-primary/40 hover:shadow-2xl hover:shadow-primary/5"
            : "p-8 rounded-custom bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800 hover:border-primary/20 dark:hover:border-primary/20 hover:shadow-xl hover:shadow-primary/5"
        ]}>
          
          {/* Card Image Header (Only for Oak City layout) */}
          {themeConfig.style === 'oak-city' && (
            <div class="aspect-video w-full overflow-hidden relative z-0 shrink-0">
              <img src={service.image || `/service-${index + 1}.jpg`} alt={service.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/20 to-transparent z-10"></div>
            </div>
          )}

          {/* Card Content Wrapper */}
          <div class:list={[
            "flex flex-col justify-between flex-grow",
            themeConfig.style === 'oak-city' ? "p-6" : ""
          ]}>
            
            {/* Ambient Background decoration (Disabled for Oak City) */}
            {themeConfig.style !== 'oak-city' && (
              <div class="absolute top-0 right-0 w-24 h-24 bg-primary/5 group-hover:bg-primary/10 rounded-bl-full transition-all pointer-events-none"></div>
            )}

            <div class="space-y-4">
              {/* Icon/Number */}
              <div class="w-12 h-12 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold text-lg group-hover:bg-primary group-hover:text-white transition-all">
                {String(index + 1).padStart(2, '0')}
              </div>

              {/* Content */}
              <h3 class="text-2xl font-bold text-slate-900 dark:text-white group-hover:text-primary transition-colors uppercase tracking-tight">
                {service.title}
              </h3>
              
              <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed font-normal">
                {service.shortDescription}
              </p>

              {/* Features list */}
              <ul class="space-y-2 pt-2 text-xs font-semibold text-slate-600 dark:text-slate-300">
                {service.features.map((feature) => (
                  <li class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>

            {/* Link/Button */}
            <div class="pt-6 mt-6 border-t border-slate-200/50 dark:border-slate-800/50">
              <a href={`/services/${service.slug}`} class="inline-flex items-center gap-1.5 text-sm font-bold text-primary group-hover:text-primary-hover hover:gap-2.5 transition-all uppercase tracking-wider">
                Learn More
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>

          </div>
        </div>
      ))}
    </div>
  </div>
</section>
