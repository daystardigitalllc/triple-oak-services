---
// BadgeExquisitus.astro
// Tiny status tag badge pills matching the Exquisitus theme styling.

interface Props {
  text?: string;
  type?: 'note' | 'success' | 'warning' | 'danger' | 'info';
  class?: string;
}

const {
  text = 'New',
  type = 'note',
  class: className = ''
} = Astro.props;

const typeStyles = {
  note: 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700',
  success: 'bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 border-emerald-200 dark:border-emerald-900/35',
  warning: 'bg-amber-50 dark:bg-amber-950/30 text-amber-700 dark:text-amber-400 border-amber-200 dark:border-amber-900/35',
  danger: 'bg-rose-50 dark:bg-rose-955/25 text-rose-700 dark:text-rose-450 border-rose-200 dark:border-rose-900/35',
  info: 'bg-blue-5/10 dark:bg-blue-950/30 text-blue-700 dark:text-blue-400 border-blue-200/50 dark:border-blue-900/35'
};

const styles = typeStyles[type] || typeStyles.note;
---

<span class:list={[
  "inline-flex items-center justify-center px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-md border shadow-sm select-none",
  styles,
  className
]}>
  {text}
</span>
