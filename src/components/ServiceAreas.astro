---
// Homepage "areas we serve" section - a real Tennessee county map (US
// Census Bureau boundary data, CC0 / public domain, via Wikimedia
// Commons: https://commons.wikimedia.org/wiki/File:Tennessee_county_map,_cb_500k.svg)
// cropped to the counties we actually serve. Hovering a county on the
// map or a city in the list highlights the same county on both sides.
import locationsData from '../data/locations.json';
import businessData from '../data/business.json';
import rawCountyMap from '../data/tn-county-map.svg?raw';

const priorityOrder = [
  'nashville', 'hendersonville', 'gallatin', 'white-house', 'portland', 'springfield',
];
const sorted = [
  ...priorityOrder.map((slug) => locationsData.find((l) => l.slug === slug)).filter(Boolean),
  ...locationsData.filter((l) => !priorityOrder.includes(l.slug)),
];

const serviceCountyIds = [...new Set(locationsData.flatMap((l) => l.countyIds))];

// County -> cities in it, for the map tooltip.
const citiesByCounty = new Map<string, string[]>();
for (const loc of locationsData) {
  for (const county of loc.countyIds) {
    citiesByCounty.set(county, [...(citiesByCounty.get(county) || []), loc.name]);
  }
}

// Pull just the inner county <path> group out of the source file so we
// control the outer <svg> (viewBox, classes) ourselves, and strip the
// source's per-county fill colors so our own CSS drives the styling.
const innerMatch = rawCountyMap.match(/<g[^>]*>([\s\S]*)<\/g>/);
const countyPaths = (innerMatch ? innerMatch[1] : '')
  .replace(/\s+fill="#[0-9a-fA-F]{3,6}"/g, '')
  .replace(/<path /g, '<path tabindex="0" ');

// Crop the map's own coordinate space down to the 6 counties we serve
// (hand-measured from the source file's county paths), padded out and
// forced to a widescreen aspect so it reads as "zoomed into Middle TN"
// rather than the whole state.
const vbX = 239.6;
const vbY = -14.3;
const vbW = 211.8;
const vbH = 156.9;
---

<section id="service-areas" class="py-20 bg-neutral-950 border-t border-neutral-900 relative overflow-hidden text-white">
  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-2xl mx-auto text-center space-y-4 mb-14">
      <span class="text-xs font-bold uppercase tracking-wider text-primary bg-primary/10 px-3.5 py-1.5 rounded-md border border-primary/20">
        Service Area
      </span>
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight uppercase leading-[1.1]">
        Proudly Serving <span class="text-primary">Middle Tennessee</span>
      </h2>
      <p class="text-neutral-400 text-base sm:text-lg leading-relaxed">
        {businessData.name} covers {locationsData.length} communities across {serviceCountyIds.length} counties in Middle Tennessee, based out of Nashville.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-6 items-center">
      {/* Map */}
      <div class="lg:col-span-3" id="tn-county-map-wrap">
        <svg
          viewBox={`${vbX} ${vbY} ${vbW} ${vbH}`}
          class="w-full h-auto"
          role="img"
          aria-label={`Map of Middle Tennessee counties served by ${businessData.name}`}
        >
          <Fragment set:html={countyPaths} />
        </svg>
      </div>

      {/* City list */}
      <div class="lg:col-span-2">
        <div class="grid grid-cols-2 gap-3">
          {sorted.map((loc) => (
            <a
              href={`/locations/${loc.slug}`}
              class="service-area-chip px-4 py-3 rounded-custom text-sm font-semibold bg-neutral-900/60 border border-neutral-800 text-neutral-200 hover:border-primary/50 hover:text-primary transition-all text-center"
              data-counties={loc.countyIds.join(',')}
            >
              {loc.name}, TN
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style define:vars={{ serviceCounties: JSON.stringify(serviceCountyIds) }}>
  #tn-county-map-wrap :global(path) {
    fill: #1c1c1f;
    stroke: #3f3f46;
    stroke-width: 0.4;
  }

  /* Counties we actually serve get a visible base tint and become
     interactive; everything else stays flat/inert background context. */
  #tn-county-map-wrap :global(path.is-served) {
    fill: color-mix(in srgb, var(--color-primary) 16%, #1c1c1f);
    stroke: color-mix(in srgb, var(--color-primary) 45%, #3f3f46);
    cursor: pointer;
    transition: fill 0.25s ease, stroke 0.25s ease;
  }
  #tn-county-map-wrap :global(path.is-served:hover),
  #tn-county-map-wrap :global(path.is-served.is-active) {
    fill: var(--color-primary);
    stroke: white;
  }
  #tn-county-map-wrap :global(path.is-served:focus-visible) {
    outline: 2px solid white;
    outline-offset: 1px;
  }

  .service-area-chip.is-active {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
  }
</style>

<script define:vars={{ serviceCountyIds, citiesByCounty: Object.fromEntries(citiesByCounty) }}>
  (() => {
    const svg = document.querySelector('#tn-county-map-wrap svg');
    if (!svg) return;

    // Mark the counties we serve, add a native tooltip listing the
    // cities in each, and hide the rest of the state's paths from
    // assistive tech since they carry no useful information here.
    const countyPaths = new Map();
    svg.querySelectorAll('path[id]').forEach((path) => {
      const id = path.getAttribute('id');
      if (serviceCountyIds.includes(id)) {
        path.classList.add('is-served');
        path.setAttribute('role', 'link');
        const cities = citiesByCounty[id] || [];
        path.setAttribute('aria-label', `${id} County - ${cities.join(', ')}`);
        const title = document.createElementNS('http://www.w3.org/2000/svg', 'title');
        title.textContent = `${id} County: ${cities.join(', ')}`;
        path.appendChild(title);
        countyPaths.set(id, path);
      } else {
        path.setAttribute('aria-hidden', 'true');
      }
    });

    const chips = document.querySelectorAll('.service-area-chip');

    function setActive(countyIds, active) {
      countyIds.forEach((id) => {
        countyPaths.get(id)?.classList.toggle('is-active', active);
      });
    }

    // Hovering (or focusing) a county on the map highlights it directly
    // via CSS (:hover/.is-served), so we only need JS for the other
    // direction: hovering a city chip highlights its county on the map.
    chips.forEach((chip) => {
      const counties = (chip.getAttribute('data-counties') || '').split(',').filter(Boolean);
      chip.addEventListener('mouseenter', () => setActive(counties, true));
      chip.addEventListener('mouseleave', () => setActive(counties, false));
      chip.addEventListener('focus', () => setActive(counties, true));
      chip.addEventListener('blur', () => setActive(counties, false));
    });

    // The reverse: hovering/focusing a county on the map highlights the
    // matching city chip(s) in the list below it.
    countyPaths.forEach((path, id) => {
      const matchingChips = [...chips].filter((chip) =>
        (chip.getAttribute('data-counties') || '').split(',').includes(id)
      );
      const activate = (on) => matchingChips.forEach((chip) => chip.classList.toggle('is-active', on));
      path.addEventListener('mouseenter', () => activate(true));
      path.addEventListener('mouseleave', () => activate(false));
      path.addEventListener('focus', () => activate(true));
      path.addEventListener('blur', () => activate(false));
      path.addEventListener('click', () => {
        const firstCity = matchingChips[0];
        if (firstCity) window.location.href = firstCity.getAttribute('href');
      });
    });
  })();
</script>
