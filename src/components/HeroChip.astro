---
// HeroChip.astro
// Pill-shaped alert chip badge designed for heroes and headers.
// Features clean background gradients, thin borders, and a micro-animated sliding arrow link.
import contentData from '../data/content.json';

interface Props {
  text?: string;
  link?: string;
  icon?: string;
  class?: string;
}

const {
  text = 'Special Offer: Get 10% off your first service checkup',
  link = '#quote-funnel',
  icon = 'fa-solid fa-gift',
  class: className = ''
} = Astro.props;
---

<a 
  href={link} 
  class:list={[
    "group inline-flex items-center gap-2 rounded-full border border-orange-500/30 bg-orange-500/10 px-4.5 py-1.5 text-xs font-semibold text-orange-700 hover:text-white hover:bg-orange-600 transition-all duration-300 shadow-sm w-fit",
    className
  ]}
>
  {icon && <i class:list={[icon, "text-[10px] opacity-80"]}></i>}
  <span>{text}</span>
  <i class="fa-solid fa-arrow-right text-[10px] transform transition-transform duration-300 group-hover:translate-x-1"></i>
</a>
