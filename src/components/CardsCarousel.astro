---
// CardsCarousel.astro
// Horizontal "Apple-style" cards carousel: tall image cards scroll-snap
// past each other, and clicking one opens an expanded overlay with more
// detail. Inspired by the concept behind Aceternity UI's Apple Cards
// Carousel, rebuilt from scratch as a dependency-free Astro component
// (no React, no framer-motion, no useOutsideClick hook — plain
// scroll-snap + a small vanilla-JS modal).
import contentData from '../data/content.json';

interface CarouselItem {
  src: string;
  alt?: string;
  category: string;
  title: string;
  content: string[];
}

interface Props {
  badgeOverride?: string;
  headingOverride?: string;
  subtitleOverride?: string;
  itemsOverride?: CarouselItem[];
}

const { badgeOverride, headingOverride, subtitleOverride, itemsOverride } = Astro.props;

const carousel = contentData.home?.cardsCarousel;

const badge = badgeOverride || carousel?.badge || 'Explore';
const heading = headingOverride || carousel?.heading || 'Get to Know Our Work';
const subtitle = subtitleOverride || carousel?.subtitle || 'A closer look at what we do best.';
const items: CarouselItem[] = itemsOverride || carousel?.items || [];

const uid = `cards-${Math.random().toString(36).slice(2, 9)}`;
---

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<section id="highlights" data-cards-id={uid} class="py-24 bg-white dark:bg-slate-950 relative border-t border-slate-100 dark:border-slate-900/60">
  <div class="container mx-auto px-6">
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-14">
      <span class="text-xs font-bold uppercase tracking-wider text-primary bg-primary/10 px-3 py-1.5 rounded-full">
        {badge}
      </span>
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white uppercase leading-[1.1]">
        {heading}
      </h2>
      <p class="text-base sm:text-lg text-slate-500 dark:text-slate-400 font-normal">
        {subtitle}
      </p>
    </div>
  </div>

  {/* Carousel track */}
  <div class="relative">
    <div
      data-cards-track
      class="flex overflow-x-auto snap-x snap-mandatory gap-5 pb-4 scrollbar-hide px-6 md:px-[max(1.5rem,calc((100vw-72rem)/2))] scroll-smooth"
    >
      {items.map((item, index) => (
        <button
          type="button"
          data-cards-open={index}
          class="group relative shrink-0 w-64 sm:w-72 h-80 sm:h-96 snap-start rounded-3xl overflow-hidden text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        >
          <img
            src={item.src}
            alt={item.alt || item.title}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-black/30"></div>
          <div class="absolute top-5 left-6 right-6">
            <span class="text-xs font-semibold text-white/80">{item.category}</span>
            <h3 class="mt-1 text-xl font-bold text-white leading-snug">{item.title}</h3>
          </div>
        </button>
      ))}
    </div>

    {/* Arrow controls */}
    <div class="hidden md:flex items-center justify-end gap-3 container mx-auto px-6 mt-6">
      <button
        type="button"
        data-cards-prev
        aria-label="Scroll left"
        class="w-10 h-10 rounded-full border border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-900 transition-colors"
      >
        <i class="fa-solid fa-arrow-left text-sm"></i>
      </button>
      <button
        type="button"
        data-cards-next
        aria-label="Scroll right"
        class="w-10 h-10 rounded-full border border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-900 transition-colors"
      >
        <i class="fa-solid fa-arrow-right text-sm"></i>
      </button>
    </div>
  </div>

  {/* Expanded card modal */}
  <div
    data-cards-modal
    class="fixed inset-0 z-50 hidden opacity-0 transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
  >
    <div data-cards-backdrop class="absolute inset-0 bg-slate-950/80 backdrop-blur-sm"></div>
    <div class="relative h-full overflow-y-auto py-8 px-4 sm:py-16">
      <div
        data-cards-panel
        class="relative mx-auto max-w-2xl bg-white dark:bg-slate-900 rounded-3xl overflow-hidden shadow-2xl scale-95 transition-transform duration-300"
      >
        <button
          type="button"
          data-cards-close
          aria-label="Close"
          class="absolute top-4 right-4 z-10 w-9 h-9 rounded-full bg-slate-900/70 text-white flex items-center justify-center hover:bg-slate-900 transition-colors"
        >
          <i class="fa-solid fa-xmark text-sm"></i>
        </button>
        <div class="h-64 sm:h-80 w-full overflow-hidden">
          <img data-cards-modal-image src="" alt="" class="w-full h-full object-cover" />
        </div>
        <div class="p-6 sm:p-8 space-y-4">
          <span data-cards-modal-category class="text-xs font-semibold uppercase tracking-wider text-primary"></span>
          <h3 data-cards-modal-title class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white leading-tight"></h3>
          <div data-cards-modal-content class="space-y-3 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ uid, items }}>
  (() => {
    const root = document.querySelector(`[data-cards-id="${uid}"]`);
    if (!root) return;

    const track = root.querySelector('[data-cards-track]');
    const prevBtn = root.querySelector('[data-cards-prev]');
    const nextBtn = root.querySelector('[data-cards-next]');
    const modal = root.querySelector('[data-cards-modal]');
    const backdrop = root.querySelector('[data-cards-backdrop]');
    const panel = root.querySelector('[data-cards-panel]');
    const closeBtn = root.querySelector('[data-cards-close]');
    const modalImage = root.querySelector('[data-cards-modal-image]');
    const modalCategory = root.querySelector('[data-cards-modal-category]');
    const modalTitle = root.querySelector('[data-cards-modal-title]');
    const modalContent = root.querySelector('[data-cards-modal-content]');

    function scrollByCard(direction) {
      const card = track.querySelector('[data-cards-open]');
      const amount = card ? card.getBoundingClientRect().width + 20 : 300;
      track.scrollBy({ left: direction * amount, behavior: 'smooth' });
    }

    prevBtn?.addEventListener('click', () => scrollByCard(-1));
    nextBtn?.addEventListener('click', () => scrollByCard(1));

    function openModal(index) {
      const item = items[index];
      if (!item) return;

      modalImage.src = item.src;
      modalImage.alt = item.alt || item.title;
      modalCategory.textContent = item.category;
      modalTitle.textContent = item.title;
      modalContent.innerHTML = '';
      (item.content || []).forEach((paragraph) => {
        const p = document.createElement('p');
        p.textContent = paragraph;
        modalContent.appendChild(p);
      });

      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0');
        panel.classList.remove('scale-95');
      });
    }

    function closeModal() {
      modal.classList.add('opacity-0');
      panel.classList.add('scale-95');
      document.body.style.overflow = '';
      setTimeout(() => modal.classList.add('hidden'), 300);
    }

    track.querySelectorAll('[data-cards-open]').forEach((btn) => {
      btn.addEventListener('click', () => openModal(Number(btn.dataset.cardsOpen)));
    });

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });
  })();
</script>
