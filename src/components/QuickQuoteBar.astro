---
// A compact, single-row lead-capture form (name, phone, email, service,
// submit) meant to sit right under the hero, above the marquee - the fast
// path for someone who already knows they want a quote and doesn't want
// to scroll to the full multi-step funnel further down the page. Same
// Web3Forms endpoint and placeholder-key detection as QuoteFunnel.astro,
// reused here via `idPrefix` so this component can also be dropped inside
// the mobile "Get a Quote" popup without id collisions.
import businessData from '../data/business.json';
import contentData from '../data/content.json';

interface Props {
  idPrefix?: string;
  compact?: boolean;
}

const { idPrefix = 'quickquote', compact = false } = Astro.props;
const id = (name: string) => `${idPrefix}-${name}`;
---

<div id={id('root')} class:list={['w-full', compact ? '' : 'bg-white border-y border-neutral-200 shadow-xl']}>
  <form
    id={id('form')}
    action="https://api.web3forms.com/submit"
    method="POST"
    class:list={['flex flex-col md:flex-row md:items-end gap-4', compact ? '' : 'px-6 py-5 md:px-12 md:py-6']}
  >
    <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
    <input type="hidden" name="subject" value={`New Quick Quote from ${businessData.name}`} />
    <input type="hidden" name="from_name" value={businessData.name} />
    <label class="hidden" aria-hidden="true">
      Leave this field blank
      <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
    </label>

    <div class="flex-1 min-w-0 space-y-1">
      <label for={id('name')} class="block text-[11px] font-bold uppercase tracking-wider text-neutral-500">Name</label>
      <input id={id('name')} type="text" name="name" placeholder="Your name" required class="w-full px-3.5 py-2.5 bg-neutral-50 border border-neutral-200 rounded-lg text-sm text-neutral-900 placeholder-neutral-400 focus:ring-2 focus:ring-primary focus:border-primary outline-none" />
    </div>

    <div class="flex-1 min-w-0 space-y-1">
      <label for={id('phone')} class="block text-[11px] font-bold uppercase tracking-wider text-neutral-500">Phone</label>
      <input id={id('phone')} type="tel" name="phone" placeholder="(615) 555-5555" required class="w-full px-3.5 py-2.5 bg-neutral-50 border border-neutral-200 rounded-lg text-sm text-neutral-900 placeholder-neutral-400 focus:ring-2 focus:ring-primary focus:border-primary outline-none" />
    </div>

    <div class="flex-1 min-w-0 space-y-1">
      <label for={id('email')} class="block text-[11px] font-bold uppercase tracking-wider text-neutral-500">Email</label>
      <input id={id('email')} type="email" name="email" placeholder="you@email.com" required class="w-full px-3.5 py-2.5 bg-neutral-50 border border-neutral-200 rounded-lg text-sm text-neutral-900 placeholder-neutral-400 focus:ring-2 focus:ring-primary focus:border-primary outline-none" />
    </div>

    <div class="flex-1 min-w-0 space-y-1">
      <label for={id('service')} class="block text-[11px] font-bold uppercase tracking-wider text-neutral-500">Service</label>
      <select id={id('service')} name="service_requested" required class="w-full px-3.5 py-2.5 bg-neutral-50 border border-neutral-200 rounded-lg text-sm text-neutral-900 focus:ring-2 focus:ring-primary focus:border-primary outline-none">
        <option value="" selected disabled>Select a service</option>
        {contentData.services.map((service) => (
          <option value={service.title}>{service.title}</option>
        ))}
      </select>
    </div>

    <button type="submit" id={id('submit')} class="shrink-0 px-7 py-2.5 font-bold text-white bg-primary hover:bg-primary-hover rounded-lg shadow-md shadow-primary/25 transition-all disabled:opacity-60 disabled:pointer-events-none">
      <span data-submit-label>Get My Free Quote</span>
    </button>
  </form>

  <p id={id('feedback')} class="hidden px-5 md:px-6 pb-4 text-sm font-semibold" role="status"></p>
</div>

<script define:vars={{ idPrefix }}>
  (() => {
    const form = document.getElementById(`${idPrefix}-form`);
    const feedback = document.getElementById(`${idPrefix}-feedback`);
    const submitBtn = document.getElementById(`${idPrefix}-submit`);
    const submitLabel = submitBtn?.querySelector('[data-submit-label]');
    if (!form) return;

    function setFeedback(message, isError) {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.classList.remove('hidden', 'text-red-600', 'text-primary');
      feedback.classList.add(isError ? 'text-red-600' : 'text-primary');
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (submitBtn) submitBtn.disabled = true;
      if (submitLabel) submitLabel.textContent = 'Sending...';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = await response.json().catch(() => null);
        const isPlaceholderKey = typeof result?.message === 'string' && /insert your actual/i.test(result.message);

        if (response.ok && result?.success && !isPlaceholderKey) {
          form.reset();
          form.classList.add('hidden');
          setFeedback("Thanks - we've got your info and will be in touch shortly.", false);
        } else {
          throw new Error('placeholder or failed');
        }
      } catch {
        setFeedback('Something went wrong. Please call us directly instead.', true);
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (submitLabel) submitLabel.textContent = 'Get My Free Quote';
      }
    });
  })();
</script>
