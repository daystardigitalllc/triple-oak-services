---
import businessData from '../data/business.json';
import themeConfig from '../data/theme.config.json';

const isOakCity = themeConfig.style === 'oak-city';
---

<section class="py-20 bg-white dark:bg-neutral-950 relative overflow-hidden">
  <div class="container mx-auto px-6 relative z-10">
    <div class="relative rounded-custom overflow-hidden shadow-2xl bg-gradient-to-br from-primary via-neutral-900 to-secondary text-white p-8 md:p-16">

      <div class="max-w-2xl mx-auto space-y-6 relative z-10 text-center">
        <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight uppercase">
          Get Your Free Estimate Today
        </h2>

        <p class="text-neutral-300 text-base sm:text-lg leading-relaxed">
          Get a free, no-obligation quote from {businessData.name} today.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-4 pt-4">
          <a href="#quote-funnel" class:list={[
            "inline-flex items-center justify-center px-8 py-4 text-base font-bold transition-all hover:scale-103 text-center",
            isOakCity
              ? "text-white bg-transparent border-2 border-white hover:bg-white hover:text-neutral-950 rounded-custom"
              : "text-neutral-950 bg-white hover:bg-neutral-100 rounded-custom shadow-lg"
          ]}>
            {businessData.mainCta}
          </a>
          <a href={`tel:${businessData.phone}`} class="inline-flex items-center justify-center px-8 py-4 text-base font-bold border-2 border-white/20 hover:bg-white/10 rounded-custom transition-all text-center gap-2">
            <i class="fa-solid fa-phone text-xs"></i> Call: {businessData.phone}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
