---
// CtaAccentCard.astro
// High-impact CTA banner housed within a rounded capsule, featuring bold gradients and custom mascot/badge graphics.
// Inspired by creative SaaS and consumer landing page newsletter banners.
import contentData from '../data/content.json';
import businessData from '../data/business.json';

interface Props {
  titleOverride?: string;
  descriptionOverride?: string;
  bgGradientClass?: string;
  ctaTextOverride?: string;
  ctaHrefOverride?: string;
  mascotSrcOverride?: string;
}

const {
  titleOverride,
  descriptionOverride,
  bgGradientClass = 'from-cyan-400 via-sky-400 to-sky-500',
  ctaTextOverride,
  ctaHrefOverride,
  mascotSrcOverride,
} = Astro.props;

const data = contentData.home?.ctaAccentCard || contentData.home?.cta;

const title = titleOverride || data?.title || 'Join the Early Access Program';
const description = descriptionOverride || data?.description || 'Sign up to receive exclusive updates and secure your spot in our limited beta program.';
const ctaText = ctaTextOverride || data?.ctaText || 'Sign Up Now';
const ctaHref = ctaHrefOverride || data?.ctaHref || '#quote-funnel';
const mascotSrc = mascotSrcOverride || data?.mascotSrc || '';
---

<section id="cta-accent" class="py-16 bg-[#FCFBF9] text-slate-800 border-b border-orange-100/30">
  <div class="container mx-auto px-6 max-w-4.5xl">
    
    <!-- Capsule Container -->
    <div class:list={[
      "rounded-3.5xl p-8 sm:p-14 text-center text-white shadow-xl shadow-sky-950/5 relative overflow-hidden bg-gradient-to-r flex flex-col items-center justify-center space-y-6 border border-white/20",
      bgGradientClass
    ]}>
      <!-- Background pattern element -->
      <div class="absolute inset-0 opacity-15 pointer-events-none">
        <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="grid-pattern-accent" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1.5" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#grid-pattern-accent)" />
        </svg>
      </div>

      <div class="relative z-10 max-w-2xl mx-auto space-y-4">
        <!-- Title -->
        <h2 class="text-3xl sm:text-4.5xl font-bold tracking-tight text-white drop-shadow-sm font-sans leading-none">
          {title}
        </h2>
        
        <!-- Description -->
        <p class="text-white/90 text-sm sm:text-base font-medium leading-relaxed max-w-lg mx-auto">
          {description}
        </p>
      </div>

      <!-- Mascot Graphic (renders SVG if no image is passed) -->
      <div class="relative z-10 w-24 h-24 my-2 flex items-center justify-center animate-wiggle">
        {mascotSrc && mascotSrc !== '' ? (
          <img src={mascotSrc} alt="Early Access Mascot" class="w-full h-full object-contain" />
        ) : (
          <!-- Charming inline waving mascot SVG -->
          <svg class="w-20 h-20 text-white drop-shadow-md" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M32 4C36.4183 4 40 7.58172 40 12C40 13.5676 39.5492 15.0302 38.7758 16.2625C43.0335 18.2384 46 22.5185 46 27.5C46 33.0228 41.5228 37.5 36 37.5H28C22.4772 37.5 18 33.0228 18 27.5C18 22.5185 20.9665 18.2384 25.2242 16.2625C24.4508 15.0302 24 13.5676 24 12C24 7.58172 27.5817 4 32 4Z" fill="currentColor"/>
            <rect x="22" y="24" width="20" height="20" rx="6" fill="#1E293B" stroke="currentColor" stroke-width="3"/>
            <circle cx="28" cy="32" r="3" fill="#38BDF8"/>
            <circle cx="36" cy="32" r="3" fill="#38BDF8"/>
            <path d="M30 37C30 38.1046 30.8954 39 32 39C33.1046 39 34 38.1046 34 37H30Z" fill="#F43F5E"/>
            <path d="M42 32C45.3137 32 48 29.3137 48 26" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
            <path d="M22 32C18.6863 32 16 29.3137 16 26" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
            <!-- Antenna -->
            <path d="M32 18V24" stroke="currentColor" stroke-width="3"/>
            <circle cx="32" cy="16" r="3" fill="#F59E0B"/>
          </svg>
        )}
      </div>

      <!-- Action Button (Orange Pill Button to contrast beautifully with cyan/sky backgrounds) -->
      <div class="relative z-10 pt-2 w-full sm:w-auto">
        <a 
          href={ctaHref}
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-full text-base font-bold text-white bg-orange-600 hover:bg-orange-700 active:bg-orange-800 transition-all hover:scale-103 shadow-lg shadow-orange-700/20 cursor-pointer"
        >
          {ctaText}
        </a>
      </div>

    </div>

  </div>
</section>

<style>
  @keyframes wiggle {
    0%, 100% { transform: rotate(0deg) translateY(0); }
    25% { transform: rotate(3deg) translateY(-2px); }
    75% { transform: rotate(-3deg) translateY(1px); }
  }
  .animate-wiggle {
    animation: wiggle 6s ease-in-out infinite;
  }
</style>
