---
import businessData from '../data/business.json';
import contentData from '../data/content.json';
import themeConfig from '../data/theme.config.json';

interface Props {
  layout?: 'split' | 'glass' | 'minimal' | 'contractor' | 'oak-city';
  h1Override?: string;
  supportingOverride?: string;
}

const { 
  layout = themeConfig.style === 'oak-city' ? 'oak-city' : (themeConfig.style === 'sharp-contractor' ? 'contractor' : (themeConfig.style === 'modern-glass' ? 'glass' : 'split')),
  h1Override,
  supportingOverride
} = Astro.props;

const h1 = h1Override || contentData.home.hero.h1;
const supporting = supportingOverride || contentData.home.hero.supporting;
const badge = contentData.home.hero.badge;
const ctaText = contentData.home.hero.ctaText;

const isContractor = layout === 'contractor' || layout === 'oak-city';
const bgImage = contentData.home.hero.bgImage || '/hero-bg.jpg';
---

<section
  id={layout === 'oak-city' ? 'hero-section' : undefined}
  class:list={[
    "relative overflow-hidden py-20 lg:py-36",
    isContractor ? "bg-slate-950 text-white bg-cover bg-center" : "bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white"
  ]}
  style={isContractor ? `background-image: linear-gradient(to bottom, rgba(15, 23, 42, 0.65), rgba(15, 23, 42, 0.8)), url('${bgImage}');` : ''}
>
  {/* Conditionally render video background for Oak City theme */}
  {layout === 'oak-city' && themeConfig.heroVideo && (
    <video autoplay loop muted playsinline class="absolute inset-0 w-full h-full object-cover z-0">
      <source src={themeConfig.heroVideo} type="video/mp4" />
    </video>
  )}
  {layout === 'oak-city' && themeConfig.heroVideo && (
    <div class="absolute inset-0 bg-slate-950/70 z-0"></div>
  )}

  {/* Static background trees, right side of hero. Pure decoration, never move. */}
  {layout === 'oak-city' && (
    <div class="hidden lg:block absolute right-2 xl:right-8 bottom-0 z-[1] pointer-events-none w-[110px] xl:w-[135px] opacity-60">
      <svg viewBox="0 0 220 420" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
        <path d="M96 415 C91 375 90 330 97 285 L123 285 C130 330 129 375 124 415 Z" fill="#241609" />
        <g fill="#204a2b">
          <circle cx="110" cy="200" r="60" />
          <circle cx="66" cy="225" r="34" />
          <circle cx="154" cy="220" r="36" />
          <circle cx="86" cy="160" r="36" />
          <circle cx="136" cy="156" r="36" />
          <circle cx="110" cy="135" r="38" />
        </g>
      </svg>
    </div>
  )}
  {layout === 'oak-city' && (
    <div class="hidden lg:block absolute right-32 xl:right-48 bottom-0 z-[1] pointer-events-none w-[90px] xl:w-[110px] opacity-45">
      <svg viewBox="0 0 220 420" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
        <path d="M96 415 C91 380 90 342 97 305 L123 305 C130 342 129 380 124 415 Z" fill="#1c1207" />
        <g fill="#173a20">
          <circle cx="110" cy="240" r="52" />
          <circle cx="70" cy="262" r="30" />
          <circle cx="150" cy="258" r="32" />
          <circle cx="110" cy="188" r="34" />
        </g>
      </svg>
    </div>
  )}

  {/* Falling tree, right side of hero. Rides scroll progress down through the section, then stays gone. */}
  {layout === 'oak-city' && (
    <div
      id="hero-falling-tree"
      class="hidden lg:block absolute right-8 xl:right-20 bottom-0 z-[2] pointer-events-none w-[170px] xl:w-[210px]"
      style="transform-origin: bottom center; will-change: transform, opacity;"
    >
      <svg viewBox="0 0 220 420" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto drop-shadow-[0_18px_20px_rgba(0,0,0,0.45)]">
        <defs>
          <linearGradient id="tree-trunk-grad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#2b1a10" />
            <stop offset="45%" stop-color="#5a3a22" />
            <stop offset="100%" stop-color="#22140c" />
          </linearGradient>
          <radialGradient id="tree-canopy-grad" cx="38%" cy="32%" r="75%">
            <stop offset="0%" stop-color="var(--color-primary)" stop-opacity="0.55" />
            <stop offset="35%" stop-color="var(--color-accent)" />
            <stop offset="100%" stop-color="#1c3d24" />
          </radialGradient>
        </defs>

        <ellipse cx="110" cy="410" rx="38" ry="8" fill="#000" opacity="0.28" />

        <!-- Root flare -->
        <path d="M110 415 C96 400 90 388 92 372 C86 386 78 396 64 402 C80 394 92 396 100 406 Z" fill="url(#tree-trunk-grad)" />
        <path d="M110 415 C124 400 130 388 128 372 C134 386 142 396 156 402 C140 394 128 396 120 406 Z" fill="url(#tree-trunk-grad)" />

        <!-- Trunk -->
        <path d="M96 415 C90 370 89 320 96 275 C99 250 101 225 99 205 L121 205 C119 225 121 250 124 275 C131 320 130 370 124 415 Z" fill="url(#tree-trunk-grad)" />
        <path d="M104 400 C100 355 100 310 106 270" stroke="#1c1008" stroke-width="2" stroke-linecap="round" opacity="0.5" fill="none" />
        <path d="M116 395 C119 352 118 308 114 268" stroke="#1c1008" stroke-width="2" stroke-linecap="round" opacity="0.4" fill="none" />

        <!-- Branch forks reaching into the canopy -->
        <path d="M110 260 C90 235 72 222 46 214" stroke="url(#tree-trunk-grad)" stroke-width="12" stroke-linecap="round" fill="none" />
        <path d="M112 250 C132 222 152 208 178 198" stroke="url(#tree-trunk-grad)" stroke-width="11" stroke-linecap="round" fill="none" />
        <path d="M108 230 C104 200 106 178 116 155" stroke="url(#tree-trunk-grad)" stroke-width="10" stroke-linecap="round" fill="none" />

        <!-- Canopy: layered irregular clusters for a fuller, hand-drawn oak crown -->
        <g fill="url(#tree-canopy-grad)">
          <circle cx="110" cy="150" r="78" />
          <circle cx="48" cy="188" r="44" />
          <circle cx="176" cy="182" r="46" />
          <circle cx="34" cy="140" r="34" />
          <circle cx="190" cy="132" r="36" />
          <circle cx="62" cy="98" r="44" />
          <circle cx="160" cy="92" r="44" />
          <circle cx="110" cy="66" r="46" />
          <circle cx="86" cy="200" r="34" />
          <circle cx="138" cy="204" r="32" />
        </g>

        <!-- Depth shading, lower/inner lobes -->
        <g fill="#1c3d24" opacity="0.45">
          <circle cx="70" cy="205" r="26" />
          <circle cx="150" cy="200" r="24" />
          <circle cx="110" cy="188" r="30" />
        </g>

        <!-- Dappled highlight, matching the logo's lighter leaf clusters -->
        <g fill="var(--color-primary)" opacity="0.4">
          <circle cx="80" cy="100" r="20" />
          <circle cx="132" cy="86" r="18" />
          <circle cx="100" cy="130" r="16" />
        </g>
      </svg>
    </div>
  )}

  <!-- Glowing Background blobs (disabled for contractor theme via CSS property glow-display) -->
  <div class="absolute inset-0 pointer-events-none glow-blob-container" style="display: var(--glow-display, block);">
    <div class="absolute top-1/4 left-1/4 w-[400px] h-[400px] bg-primary/20 rounded-full blur-[100px] animate-pulse-slow"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[300px] h-[300px] bg-accent/15 rounded-full blur-[80px]"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10">
    {layout === 'split' && (
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Text Content -->
        <div class="lg:col-span-7 space-y-6 text-left animate-fade-in-up">
          {badge && (
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold tracking-wide uppercase text-primary bg-primary/10 rounded-full">
              {badge}
            </span>
          )}
          
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.1]">
            <span class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 dark:from-white dark:via-slate-100 dark:to-white bg-clip-text text-transparent">{h1.split(' ').slice(0, -2).join(' ')}</span>
            <span class="bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent"> {h1.split(' ').slice(-2).join(' ')}</span>
          </h1>

          <p class="text-lg md:text-xl text-slate-600 dark:text-slate-300 font-normal leading-relaxed max-w-2xl">
            {supporting}
          </p>

          <!-- Conversion Area -->
          <div class="flex flex-col sm:flex-row gap-4 pt-2">
            <a href="#quote-funnel" class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-primary hover:bg-primary-hover rounded-custom shadow-lg shadow-primary/25 transition-all hover:scale-103">
              {ctaText}
            </a>
            <a href="tel:businessData.phone" class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-slate-700 dark:text-slate-300 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-custom transition-all">
              Call {businessData.phone}
            </a>
          </div>

          <!-- Trust items -->
          <div class="flex flex-wrap gap-x-6 gap-y-3 pt-6 text-sm text-slate-500 dark:text-slate-400">
            {businessData.certifications.slice(0, 3).map((cert) => (
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M6.267 3.455a.75.75 0 00-.708.523L4.547 7H1.75a.75.75 0 00-.75.75v3.5c0 .414.336.75.75.75h2.797l1.012 3.022a.75.75 0 00.708.523h1.75a.75.75 0 00.75-.75V3.455a.75.75 0 00-.75-.75H6.267zM14.78 6.22a.75.75 0 011.06 0l2.5 2.5a.75.75 0 010 1.06l-2.5 2.5a.75.75 0 11-1.06-1.06L16.44 10l-1.66-1.66a.75.75 0 010-1.06z" clip-rule="evenodd"/>
                </svg>
                {cert}
              </div>
            ))}
          </div>
        </div>

        <!-- Right Side Visual / Hero Card -->
        <div class="lg:col-span-5 relative animate-fade-in-up" style="animation-delay: 0.2s">
          <div class="relative mx-auto max-w-md lg:max-w-none">
            <!-- Back decoration card -->
            <div class="absolute -inset-2 bg-gradient-to-tr from-primary to-accent rounded-custom blur-xl opacity-30 animate-pulse-slow"></div>
            
            <!-- Lead capture form styled beautifully -->
            <div class="relative glass-panel bg-white/90 dark:bg-slate-900/90 rounded-custom p-8 shadow-2xl border border-slate-200/50 dark:border-slate-800/50">
              <h3 class="text-2xl font-bold text-slate-900 dark:text-white">Get a Free Estimate</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Book your free, no-obligation estimate today.</p>
              
              <form action="#quote-funnel" class="mt-6 space-y-4">
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">What service do you need?</label>
                  <select class="w-full px-4 py-3 bg-slate-100 dark:bg-slate-800 border-0 rounded-lg text-sm text-slate-700 dark:text-slate-300 focus:ring-2 focus:ring-primary">
                    {contentData.services.map((service) => (
                      <option>{service.title}</option>
                    ))}
                  </select>
                </div>
                
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Your Name</label>
                  <input type="text" placeholder="John Smith" class="w-full px-4 py-3 bg-slate-100 dark:bg-slate-800 border-0 rounded-lg text-sm placeholder-slate-400 focus:ring-2 focus:ring-primary" required />
                </div>

                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Phone Number</label>
                  <input type="tel" placeholder="(555) 555-5555" class="w-full px-4 py-3 bg-slate-100 dark:bg-slate-800 border-0 rounded-lg text-sm placeholder-slate-400 focus:ring-2 focus:ring-primary" required />
                </div>

                <button type="submit" class="w-full py-3.5 font-bold text-white bg-primary hover:bg-primary-hover rounded-lg shadow-md shadow-primary/20 transition-all">
                  Submit Estimate Request
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    )}

    {layout === 'glass' && (
      <div class="max-w-4xl mx-auto text-center space-y-8 animate-fade-in-up">
        {badge && (
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold tracking-wide uppercase text-primary bg-primary/10 rounded-full">
            {badge}
          </span>
        )}

        <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight leading-[1.05] text-slate-900 dark:text-white">
          {h1.split(' ').slice(0, -2).join(' ')}
          <span class="bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent"> {h1.split(' ').slice(-2).join(' ')}</span>
        </h1>

        <p class="text-lg md:text-2xl text-slate-600 dark:text-slate-300 font-normal leading-relaxed max-w-3xl mx-auto">
          {supporting}
        </p>

        <!-- Glass card inline element -->
        <div class="glass-panel p-6 sm:p-8 rounded-custom max-w-2xl mx-auto shadow-xl border border-white/20">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <a href="#quote-funnel" class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-primary hover:bg-primary-hover rounded-custom shadow-lg shadow-primary/25 transition-all">
              {ctaText}
            </a>
            <a href={`tel:${businessData.phone}`} class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-slate-800 dark:text-white bg-white/40 dark:bg-slate-900/40 hover:bg-white/60 dark:hover:bg-slate-800/60 rounded-custom transition-all">
              Call Now: {businessData.phone}
            </a>
          </div>
        </div>

        <div class="flex flex-wrap justify-center gap-x-8 gap-y-3 pt-6 text-sm text-slate-500 dark:text-slate-400">
          {businessData.certifications.map((cert) => (
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
              {cert}
            </div>
          ))}
        </div>
      </div>
    )}

    {layout === 'minimal' && (
      <div class="max-w-3xl mx-auto text-center space-y-6 py-12 animate-fade-in-up">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          {h1}
        </h1>
        <p class="text-lg md:text-xl text-slate-600 dark:text-slate-300 leading-relaxed">
          {supporting}
        </p>
        <div class="pt-6">
          <a href="#quote-funnel" class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-primary hover:bg-primary-hover rounded-custom shadow-lg shadow-primary/25 transition-all">
            {ctaText}
          </a>
        </div>
      </div>
    )}

    {layout === 'contractor' && (
      <div class="max-w-4xl mx-auto text-center space-y-8 py-10 md:py-16 animate-fade-in-up relative">
        
        <!-- Floating Info Tags (Matching Oak City top badges) -->
        <div class="hidden lg:flex justify-between items-center w-full max-w-5xl mx-auto absolute -top-12 left-1/2 -translate-x-1/2 px-6 text-[10px] text-slate-300 font-bold uppercase tracking-widest pointer-events-none">
          <div class="bg-black/35 px-4 py-2 border border-white/10 rounded">📍 {businessData.locations[0]} & Surrounding Areas</div>
          <div class="bg-black/35 px-4 py-2 border border-white/10 rounded">🛡️ {businessData.certifications[0] || 'Fully Licensed & Insured'}</div>
        </div>

        <!-- Center Logo Emblem -->
        <div class="w-20 h-20 rounded-xl bg-primary border-2 border-white/20 flex items-center justify-center text-white font-black text-3xl shadow-xl mx-auto mb-4 tracking-tighter">
          {businessData.name.split(' ').map(w => w.charAt(0)).join('')}
        </div>

        {badge && (
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-bold tracking-wide uppercase text-accent border border-accent/30 bg-accent/10 rounded-md">
            {badge}
          </span>
        )}
        
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-white leading-[1.05] uppercase">
          {h1}
        </h1>
        
        <p class="text-lg md:text-xl text-slate-200 leading-relaxed max-w-2xl mx-auto font-normal">
          {supporting}
        </p>

        <!-- Side-by-Side CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-6">
          <a href="#quote-funnel" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-accent hover:brightness-90 rounded-custom shadow-lg transition-all hover:scale-102 uppercase tracking-wide">
            {ctaText}
          </a>
          <a href={`tel:${businessData.phone}`} class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-transparent border-2 border-white/20 hover:bg-white/10 rounded-custom transition-all uppercase tracking-wide">
            📞 Call {businessData.phone}
          </a>
        </div>
      </div>
    )}

    {layout === 'oak-city' && (
      <div class="max-w-4xl mx-auto text-center space-y-8 py-10 md:py-16 animate-fade-in-up relative">
        
        <!-- Floating Info Tags (Matching Oak City top badges) -->
        <div class="hidden lg:flex justify-between items-center w-full max-w-5xl mx-auto absolute -top-12 left-1/2 -translate-x-1/2 px-6 text-[10px] text-slate-300 font-bold uppercase tracking-widest pointer-events-none gap-4">
          <div class="bg-black/45 px-4 py-2.5 border border-white/10 rounded flex items-center gap-1.5"><i class="fa-solid fa-location-dot text-primary"></i> {businessData.locations[0]} & Surrounding Areas</div>
          <div class="bg-black/45 px-4 py-2.5 border border-white/10 rounded flex items-center gap-1.5"><i class="fa-solid fa-shield-halved text-primary"></i> {businessData.certifications[0] || 'Fully Licensed & Insured'}</div>
        </div>

        {/* Center Logo Emblem */}
        {businessData.logo && businessData.logo !== '/logo.svg' && businessData.logo !== '' ? (
          <img src={businessData.logo} alt={`${businessData.name} Logo`} class="h-20 w-auto object-contain mx-auto mb-4" />
        ) : (
          <div class="w-20 h-20 rounded-xl bg-transparent border-2 border-primary flex items-center justify-center text-primary font-black text-3xl shadow-xl mx-auto mb-4 tracking-tighter">
            {businessData.name.split(' ').map(w => w.charAt(0)).join('')}
          </div>
        )}

        <h1 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight text-white leading-[1.05] uppercase">
          {h1.split(' ').slice(0, -2).join(' ')} <span id="typewriter-text" class="text-primary border-r-4 border-primary/70 pr-2 animate-caret"></span>
          <noscript>
            <span class="text-primary">{h1.split(' ').slice(-2).join(' ')}</span>
          </noscript>
        </h1>
        
        <p class="text-lg md:text-xl text-slate-200 leading-relaxed max-w-2xl mx-auto font-normal">
          {supporting}
        </p>

        <!-- Side-by-Side CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-6">
          <a href="#quote-funnel" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold text-primary bg-transparent border-2 border-primary hover:bg-primary hover:text-white rounded-custom shadow-lg transition-all hover:scale-102 uppercase tracking-wide">
            {ctaText}
          </a>
          <a href={`tel:${businessData.phone}`} class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-transparent border-2 border-white/20 hover:bg-white/10 rounded-custom transition-all uppercase tracking-wide gap-2">
            <i class="fa-solid fa-phone text-xs"></i> Call {businessData.phone}
          </a>
        </div>

        <div id="typewriter-config" data-words={JSON.stringify(themeConfig.typewriterWords && themeConfig.typewriterWords.length > 0 ? themeConfig.typewriterWords : ["Tree Care", "Emergency Response", "Stump Removal"])} class="hidden"></div>
      </div>
    )}
  </div>
</section>

{layout === 'oak-city' && (
  <script>
    const configEl = document.getElementById('typewriter-config');
    const words = configEl ? JSON.parse(configEl.getAttribute('data-words') || '[]') : [];
    
    let wordIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    const txtElement = document.getElementById('typewriter-text');
    
    function type() {
      if (!txtElement || words.length === 0) return;
      
      const currentWord = words[wordIndex];
      if (isDeleting) {
        txtElement.textContent = currentWord.substring(0, charIndex - 1);
        charIndex--;
      } else {
        txtElement.textContent = currentWord.substring(0, charIndex + 1);
        charIndex++;
      }
      
      let typeSpeed = 120;
      if (isDeleting) {
        typeSpeed /= 2;
      }
      
      if (!isDeleting && charIndex === currentWord.length) {
        typeSpeed = 1800; // Pause at end of word
        isDeleting = true;
      } else if (isDeleting && charIndex === 0) {
        isDeleting = false;
        wordIndex = (wordIndex + 1) % words.length;
        typeSpeed = 400; // Pause before next word
      }
      
      setTimeout(type, typeSpeed);
    }
    
    // Start typewriter effect after page load
    if (txtElement && words.length > 0) {
      type();
    }
  </script>
)}

{layout === 'oak-city' && (
  <script>
    const heroSection = document.getElementById('hero-section');
    const fallingTree = document.getElementById('hero-falling-tree');

    if (heroSection && fallingTree) {
      let maxProgress = 0;
      let ticking = false;

      const update = () => {
        const rect = heroSection.getBoundingClientRect();
        const sectionHeight = heroSection.offsetHeight || 1;

        // 0 while the hero sits at the top of the viewport, 1 once it has
        // fully scrolled past (hero has "disappeared from viewport").
        let raw = (-rect.top) / sectionHeight;
        raw = Math.max(0, Math.min(1, raw));

        if (window.scrollY < 2) {
          // Back at the very top: fresh visit, tree resets to standing.
          maxProgress = 0;
        } else if (raw > maxProgress) {
          // Progress only ratchets forward with downward scroll, so
          // scrolling back up never plays the fall in reverse - the tree
          // just stays wherever it last got to (gone, once it has landed).
          maxProgress = raw;
        }

        const rotate = maxProgress * 88;
        const drift = maxProgress * 36;
        fallingTree.style.transform = `translate(${drift * 0.5}px, ${drift}px) rotate(${rotate}deg)`;
        fallingTree.style.opacity = maxProgress >= 0.98 ? '0' : '1';

        ticking = false;
      };

      const onScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      update();
    }
  </script>
)}
