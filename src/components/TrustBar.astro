---
import businessData from '../data/business.json';
import contentData from '../data/content.json';

const reviews = contentData.reviews || [];
const reviewCount = reviews.length;
const avgRating = reviewCount > 0
  ? (reviews.reduce((sum: number, r: any) => sum + r.rating, 0) / reviewCount).toFixed(1)
  : null;
---

<section class="py-10 border-y border-slate-200/50 dark:border-slate-800/50 bg-slate-50/50 dark:bg-slate-900/10">
  <div class="container mx-auto px-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 md:gap-12">
      <!-- Ratings Summary -->
      {avgRating && (
        <div class="flex items-center gap-4 text-center md:text-left shrink-0">
          <div class="text-3xl font-extrabold text-slate-900 dark:text-white flex items-center gap-1 justify-center">
            {avgRating}
            <span class="text-accent text-2xl">★</span>
          </div>
          <div>
            <div class="flex text-accent text-sm">★★★★★</div>
            <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">From {reviewCount} Client Testimonials</p>
          </div>
        </div>
      )}

      <!-- Certifications Logo/Ticker -->
      <div class="w-full overflow-hidden">
        <div class="flex flex-wrap items-center justify-center md:justify-end gap-x-8 gap-y-4 text-sm font-semibold tracking-wider uppercase text-slate-400 dark:text-slate-600">
          {businessData.certifications.map((cert) => (
            <div class="flex items-center gap-2 border border-slate-200/60 dark:border-slate-800 p-2.5 rounded-lg bg-white dark:bg-slate-900/50 shadow-sm shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
              <span class="text-xs text-slate-600 dark:text-slate-300 font-semibold">{cert}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
