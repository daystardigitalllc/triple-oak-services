---
// ReviewsKepler.astro
// Staggered neo-brutalist customer quote cards in the Kepler theme style.
// Features offset solid colored shadows and cards that rotate slightly,
// straightening smoothly on hover.
import contentData from '../data/content.json';

interface ReviewItem {
  quote: string;
  name: string;
  role: string;
  initials: string;
  color: 'navy' | 'orange' | 'dark';
}

interface Props {
  badgeOverride?: string;
  headingOverride?: string;
  reviewsOverride?: ReviewItem[];
}

const {
  badgeOverride,
  headingOverride,
  reviewsOverride
} = Astro.props;

const data = contentData.home?.reviewsKepler;

const badge = badgeOverride || data?.badge || 'Loved by builders';
const heading = headingOverride || data?.title || "Don't take our word for it";

const defaultReviews: ReviewItem[] = [
  {
    quote: '"Launched my portfolio in a single evening. It scored 100 on Lighthouse without me touching a thing."',
    name: 'Jenna Kim',
    role: 'Product Designer',
    initials: 'JK',
    color: 'navy'
  },
  {
    quote: '"We rebuilt our whole marketing site on Kepler. The team preset saved us weeks of setup."',
    name: 'Marco Alvarez',
    role: 'Founder, Lumen',
    initials: 'MA',
    color: 'orange'
  },
  {
    quote: '"The MDX setup is exactly what I wanted. I write, I push, it\'s live. No fighting the framework."',
    name: 'Riya Shah',
    role: 'Indie Developer',
    initials: 'dark',
    color: 'dark'
  }
];

const reviews = reviewsOverride || data?.items || defaultReviews;
---

<section id="reviews-kepler" class="relative overflow-hidden bg-gradient-to-b from-[#0f1e42] to-[#0a142c] text-white py-24 select-none border-b-4 border-slate-950">
  
  <!-- Decorative Background Stars -->
  <span class="absolute top-12 left-[6%] text-3xl text-orange-400 animate-pulse">✦</span>
  <span class="absolute right-[7%] bottom-10 w-5 h-5 rotate-[18deg] rounded-md bg-orange-500"></span>

  <div class="container mx-auto px-6 max-w-6.5xl">
    
    <!-- Header -->
    <div class="mx-auto text-center max-w-[620px] mb-16 space-y-3">
      {badge && (
        <span class="text-xs font-bold uppercase tracking-[0.12em] text-orange-400 bg-orange-500/10 px-4 py-1.5 rounded-full border border-orange-500/20 shadow-sm">
          {badge}
        </span>
      )}
      <h2 class="text-4xl sm:text-5xl font-black leading-tight tracking-tight text-white">
        {heading}
      </h2>
    </div>

    <!-- Staggered Rotated Quote Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-4">
      {reviews.map((item, idx) => (
        <div class:list={[
          "rounded-[22px] border-2 border-slate-950 bg-white p-8 shadow-[5px_5px_0_#f97316] transition-transform duration-180 hover:rotate-0 transform text-slate-900 select-none",
          idx === 0 && "-rotate-[1.2deg]",
          idx === 1 && "rotate-1",
          idx === 2 && "-rotate-1"
        ]}>
          <!-- Quote Content -->
          <p class="text-sm sm:text-base leading-relaxed text-slate-800 font-semibold italic min-h-16">
            {item.quote}
          </p>

          <!-- User Block -->
          <div class="mt-6 flex items-center gap-3 border-t border-slate-100 pt-5">
            <!-- Initial Circle -->
            <span class:list={[
              "flex w-10.5 h-10.5 items-center justify-center rounded-full font-bold text-white text-xs shadow-sm border border-slate-950/20",
              item.color === 'navy' && 'bg-[#0f1e42]',
              item.color === 'orange' && 'bg-orange-500',
              item.color === 'dark' && 'bg-slate-950'
            ]}>
              {item.initials}
            </span>
            <div class="text-left">
              <div class="text-sm font-black text-slate-950">{item.name}</div>
              <div class="text-xs text-slate-500">{item.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
