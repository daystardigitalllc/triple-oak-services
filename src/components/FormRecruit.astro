---
// FormRecruit.astro
// Split layout lead capture & application contact form.
// Features a textual brand section on the left and a responsive input field grid on the right, completed with validation styling.
import contentData from '../data/content.json';
import businessData from '../data/business.json';

interface Props {
  badgeOverride?: string;
  headingOverride?: string;
  descriptionOverride?: string;
  apiEndpoint?: string;
}

const {
  badgeOverride,
  headingOverride,
  descriptionOverride,
  apiEndpoint = '/'
} = Astro.props;

const data = contentData.home?.formRecruit;

const badge = badgeOverride || data?.badge || 'Contact';
const heading = headingOverride || data?.title || 'Looking for a new opportunity?';
const description = descriptionOverride || data?.description || 'Submit your information below to connect with our recruitment team. We sync you with the top-tier matches immediately.';
---

<section id="contacts" class="py-24 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-800 select-none">
  <div class="container mx-auto px-6 max-w-6.5xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      
      <!-- Copy Block (Left Column) -->
      <div class="lg:col-span-5 space-y-6">
        {badge && (
          <span class="text-sm font-bold uppercase tracking-wider text-orange-500">
            {badge}
          </span>
        )}
        <h2 class="text-3xl sm:text-4.5xl font-extrabold tracking-tight text-slate-950 dark:text-white leading-tight capitalize">
          {heading}
        </h2>
        <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
          {description}
        </p>

        <!-- Dynamic direct contact details fallback -->
        <div class="space-y-3 pt-4 border-t border-slate-200 dark:border-slate-850">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Or Call Us Directly</p>
          <a href={`tel:${businessData.phone}`} class="text-xl font-bold text-slate-950 dark:text-white hover:text-orange-500 transition-colors flex items-center gap-2">
            <i class="fa-solid fa-phone text-sm text-orange-500"></i> {businessData.phone}
          </a>
        </div>
      </div>

      <!-- Application Form Block (Right Column) -->
      <div class="lg:col-span-7 bg-white dark:bg-slate-950 border border-slate-200/60 dark:border-slate-800/80 p-8 sm:p-10 shadow-xl">
        <form method="POST" action={apiEndpoint} class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            
            <!-- Full Name -->
            <div class="space-y-2">
              <label for="recruit-name" class="text-xs font-bold uppercase text-slate-400 tracking-wider">Full Name</label>
              <input 
                type="text" 
                name="name" 
                id="recruit-name" 
                required 
                placeholder="John Doe"
                class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-none focus:outline-none focus:border-orange-500 text-sm font-semibold transition-all text-slate-900 dark:text-white"
              />
            </div>

            <!-- Email Address -->
            <div class="space-y-2">
              <label for="recruit-email" class="text-xs font-bold uppercase text-slate-400 tracking-wider">Email Address</label>
              <input 
                type="email" 
                name="email" 
                id="recruit-email" 
                required 
                placeholder="john@example.com"
                class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-none focus:outline-none focus:border-orange-500 text-sm font-semibold transition-all text-slate-900 dark:text-white"
              />
            </div>

          </div>

          <!-- Contact Number -->
          <div class="space-y-2">
            <label for="recruit-phone" class="text-xs font-bold uppercase text-slate-400 tracking-wider">Contact Number</label>
            <input 
              type="tel" 
              name="phone" 
              id="recruit-phone" 
              required 
              placeholder="+1 (555) 000-0000"
              class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-none focus:outline-none focus:border-orange-500 text-sm font-semibold transition-all text-slate-900 dark:text-white"
            />
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button 
              type="submit" 
              class="inline-flex items-center justify-center gap-3 px-8 py-3.5 bg-orange-500 hover:bg-slate-950 dark:hover:bg-white text-slate-950 hover:text-white dark:hover:text-slate-950 text-xs sm:text-sm font-bold uppercase tracking-widest transition-all duration-300 rounded-none shadow-md cursor-pointer w-full sm:w-auto"
            >
              Submit Application <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>
          </div>

        </form>
      </div>

    </div>
  </div>
</section>
