---
import businessData from '../data/business.json';
import contentData from '../data/content.json';
---

<footer class="bg-slate-900 text-slate-400 pt-20 pb-10 border-t border-slate-800 relative z-10">
  <div class="container mx-auto px-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 pb-16">
    <!-- Brand column -->
    <div class="lg:col-span-4 space-y-6">
      <a href="/" class="flex items-center gap-2 group text-white">
        <div class="w-10 h-10 rounded-lg bg-primary flex items-center justify-center font-extrabold text-xl shadow-md">
          {businessData.name.charAt(0)}
        </div>
        <span class="font-bold text-xl tracking-tight">{businessData.name}</span>
      </a>
      <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
        Providing top-tier {contentData.services.map((s) => s.title).join(', ')} services with guaranteed quality. Fully licensed and locally owned.
      </p>
      <div class="flex gap-4">
        {businessData.socials?.facebook && (
          <a href={businessData.socials.facebook} class="w-9 h-9 flex items-center justify-center bg-slate-800 hover:bg-primary text-white rounded-lg transition-colors" aria-label="Facebook">
            <i class="fa-brands fa-facebook-f text-sm"></i>
          </a>
        )}
        {businessData.socials?.instagram && (
          <a href={businessData.socials.instagram} class="w-9 h-9 flex items-center justify-center bg-slate-800 hover:bg-primary text-white rounded-lg transition-colors" aria-label="Instagram">
            <i class="fa-brands fa-instagram text-sm"></i>
          </a>
        )}
        {businessData.socials?.google && (
          <a href={businessData.socials.google} class="w-9 h-9 flex items-center justify-center bg-slate-800 hover:bg-primary text-white rounded-lg transition-colors" aria-label="Google Business">
            <i class="fa-brands fa-google text-sm"></i>
          </a>
        )}
      </div>
    </div>

    <!-- Services list -->
    <div class="lg:col-span-2.5 space-y-4">
      <h4 class="font-bold text-white text-sm uppercase tracking-wider">Services</h4>
      <ul class="space-y-2 text-sm">
        {contentData.services.map((service) => (
          <li>
            <a href={`/services/${service.slug}`} class="hover:text-white transition-colors">{service.title}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Locations list -->
    <div class="lg:col-span-2.5 space-y-4">
      <h4 class="font-bold text-white text-sm uppercase tracking-wider">Locations</h4>
      <ul class="space-y-2 text-sm">
        {businessData.locations.map((loc) => (
          <li>
            <a href={`/locations/${loc.toLowerCase().replace(/ /g, '-')}`} class="hover:text-white transition-colors">{loc}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Contact details -->
    <div class="lg:col-span-3 space-y-4">
      <h4 class="font-bold text-white text-sm uppercase tracking-wider">Contact Info</h4>
      <ul class="space-y-3 text-sm">
        <li class="flex items-start gap-2.5">
          <i class="fa-solid fa-location-dot mt-1 shrink-0 text-slate-500"></i>
          <span>
            {businessData.address?.street}<br />
            {businessData.address?.city}, {businessData.address?.state} {businessData.address?.zip}
          </span>
        </li>
        <li class="flex items-center gap-2.5">
          <i class="fa-solid fa-phone shrink-0 text-slate-500"></i>
          <a href={`tel:${businessData.phone}`} class="hover:text-white transition-colors">{businessData.phone}</a>
        </li>
        <li class="flex items-center gap-2.5">
          <i class="fa-solid fa-envelope shrink-0 text-slate-500"></i>
          <a href={`mailto:${businessData.email}`} class="hover:text-white transition-colors">{businessData.email}</a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Bottom legal bar -->
  <div class="container mx-auto px-6 pt-8 border-t border-slate-800 text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-semibold text-slate-500">
    <p>&copy; {new Date().getFullYear()} {businessData.name}. All rights reserved.</p>
    <div class="flex gap-6">
      <a href="#" class="hover:text-white">Privacy Policy</a>
      <a href="#" class="hover:text-white">Terms of Service</a>
      <a href="#" class="hover:text-white">Sitemap</a>
    </div>
  </div>
</footer>
