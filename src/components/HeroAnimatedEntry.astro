---
// HeroAnimatedEntry.astro
// Centered hero with a staggered, word-by-word entrance animation on the
// headline. Concept inspired by the "Simple with entry animation" hero
// in Aceternity UI's hero-section collection, rebuilt from scratch as a
// pure Astro component — the stagger is driven entirely by CSS
// (per-word animation-delay), no JS or framer-motion required.
import businessData from '../data/business.json';
import contentData from '../data/content.json';

interface Props {
  badgeOverride?: string;
  headingOverride?: string;
  subtitleOverride?: string;
  primaryCtaTextOverride?: string;
  primaryCtaHrefOverride?: string;
  secondaryCtaTextOverride?: string;
  secondaryCtaHrefOverride?: string;
}

const {
  badgeOverride,
  headingOverride,
  subtitleOverride,
  primaryCtaTextOverride,
  primaryCtaHrefOverride,
  secondaryCtaTextOverride,
  secondaryCtaHrefOverride,
} = Astro.props;

const data = contentData.home?.heroAnimated;

const badge = badgeOverride || data?.badge || '';
const heading = headingOverride || data?.heading || businessData.name;
const subtitle = subtitleOverride || data?.subtitle || '';
const primaryCtaText = primaryCtaTextOverride || data?.primaryCtaText || businessData.mainCta || 'Get a Free Quote';
const primaryCtaHref = primaryCtaHrefOverride || data?.primaryCtaHref || '#quote-funnel';
const secondaryCtaText = secondaryCtaTextOverride || data?.secondaryCtaText || 'Call Us Now';
const secondaryCtaHrefRaw = secondaryCtaHrefOverride || data?.secondaryCtaHref || 'tel:';
const secondaryCtaHref = secondaryCtaHrefRaw === 'tel:' ? `tel:${businessData.phone}` : secondaryCtaHrefRaw;

const words = heading.split(' ');
---

<style>
  @keyframes word-in {
    from {
      opacity: 0;
      transform: translateY(0.6em);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .word-in {
    display: inline-block;
    opacity: 0;
    animation: word-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .rise-in {
    opacity: 0;
    animation: rise-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .word-in,
    .rise-in {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<section class="relative py-32 md:py-40 bg-white dark:bg-slate-950 overflow-hidden text-center border-b border-slate-100 dark:border-slate-900/60">
  <div class="absolute inset-0 pointer-events-none glow-blob-container">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[500px] h-[300px] bg-primary/10 rounded-full blur-[100px]"></div>
  </div>

  <div class="container mx-auto px-6 max-w-4xl relative z-10 flex flex-col items-center">
    {badge && (
      <span class="rise-in inline-block text-xs font-bold uppercase tracking-wider text-primary bg-primary/10 px-4 py-2 rounded-full mb-6" style="animation-delay: 0ms;">
        {badge}
      </span>
    )}

    <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight leading-[1.05] text-slate-900 dark:text-white">
      {words.map((word, i) => (
        <>
          <span class="word-in" style={`animation-delay: ${120 + i * 70}ms;`}>{word}</span>
          {' '}
        </>
      ))}
    </h1>

    {subtitle && (
      <p class="rise-in mt-6 max-w-2xl text-base sm:text-lg text-slate-500 dark:text-slate-400" style={`animation-delay: ${120 + words.length * 70 + 100}ms;`}>
        {subtitle}
      </p>
    )}

    <div class="rise-in mt-9 flex flex-col sm:flex-row gap-4" style={`animation-delay: ${120 + words.length * 70 + 250}ms;`}>
      <a
        href={primaryCtaHref}
        class="inline-flex items-center justify-center px-7 py-3.5 rounded-custom text-sm font-bold text-white bg-primary hover:bg-primary-hover transition-all hover:scale-105 shadow-md shadow-primary/20"
      >
        {primaryCtaText}
      </a>
      <a
        href={secondaryCtaHref}
        class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-custom text-sm font-bold text-slate-700 dark:text-slate-200 border-2 border-slate-200 dark:border-slate-800 hover:border-primary hover:text-primary transition-all"
      >
        <i class="fa-solid fa-phone text-xs"></i>
        {secondaryCtaText}
      </a>
    </div>
  </div>
</section>
