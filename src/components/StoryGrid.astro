---
// StoryGrid.astro
// Grid layout displaying client stories or video testmionials in highly polished vertical cards.
// Features a zoom hover effect, media play indicator, and elegant call-to-actions.
import businessData from '../data/business.json';
import contentData from '../data/content.json';

interface StoryItem {
  src: string;
  alt: string;
  label?: string;
  title?: string;
}

interface Props {
  badgeOverride?: string;
  headingOverride?: string;
  subtitleOverride?: string;
  itemsOverride?: StoryItem[];
  ctaTextOverride?: string;
  ctaHrefOverride?: string;
}

const {
  badgeOverride,
  headingOverride,
  subtitleOverride,
  itemsOverride,
  ctaTextOverride,
  ctaHrefOverride,
} = Astro.props;

const data = contentData.home?.storyGrid;

const badge = badgeOverride || data?.badge || 'Real Experiences';
const heading = headingOverride || data?.heading || 'More than a smart assistant. A daily companion.';
const subtitle = subtitleOverride || data?.subtitle || 'Ato matches context, feelings, and memories to help conversations flow naturally.';
const ctaText = ctaTextOverride || data?.ctaText || businessData.mainCta || 'Try Conversation';
const ctaHref = ctaHrefOverride || data?.ctaHref || '#quote-funnel';

const defaultStories: StoryItem[] = [
  {
    src: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=400&h=600&q=80',
    alt: 'Elderly lady smiling next to a glowing smart companion device',
    label: 'Maria, 82',
    title: 'Daily chat & music partner'
  },
  {
    src: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=400&h=600&q=80',
    alt: 'Elderly gentleman using a smart companion device in his study',
    label: 'Arthur, 78',
    title: 'Morning routine assistant'
  },
  {
    src: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=400&h=600&q=80',
    alt: 'Grandfather and grandchild talking with a companion device on table',
    label: 'The Miller Family',
    title: 'Staying connected across states'
  },
  {
    src: 'https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?auto=format&fit=crop&w=400&h=600&q=80',
    alt: 'Elderly woman playing cards and chatting with a companion device',
    label: 'Helen, 85',
    title: 'Keeping active and engaged'
  }
];

const stories = itemsOverride || data?.items || defaultStories;
---

<section id="story-grid" class="py-20 bg-white text-slate-800 border-b border-orange-100/30">
  <div class="container mx-auto px-6 max-w-6.5xl">
    
    <!-- 4-Card Media Rail -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-16">
      {stories.map((story) => (
        <div class="group relative aspect-[3/4.5] w-full rounded-2xl overflow-hidden bg-slate-100 border border-orange-100/10 shadow-lg shadow-orange-950/2 hover:-translate-y-1 transition-all duration-300">
          <!-- Image -->
          <img 
            src={story.src} 
            alt={story.alt} 
            class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-700" 
          />
          <!-- Play indicator button -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent flex flex-col justify-end p-4">
            <div class="w-10 h-10 rounded-full bg-white/95 text-orange-600 flex items-center justify-center shadow-md mb-2 group-hover:bg-orange-600 group-hover:text-white transition-all transform group-hover:scale-105">
              <i class="fa-solid fa-play text-xs translate-x-0.5"></i>
            </div>
            <!-- Labels -->
            {story.label && (
              <span class="text-xs font-bold text-orange-400 uppercase tracking-widest">{story.label}</span>
            )}
            {story.title && (
              <p class="text-xs sm:text-sm font-semibold text-white mt-0.5 line-clamp-2 leading-tight">{story.title}</p>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Centered Copy & Action -->
    <div class="max-w-2xl mx-auto text-center space-y-6">
      {badge && (
        <span class="text-xs font-bold uppercase tracking-wider text-orange-600 px-3.5 py-1.5 bg-orange-50 rounded-full border border-orange-100/50">
          {badge}
        </span>
      )}
      
      <h2 class="text-3xl sm:text-4.5xl font-serif font-medium tracking-tight text-[#2B231B] leading-tight">
        {heading}
      </h2>

      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        {subtitle}
      </p>

      <div class="pt-2">
        <a 
          href={ctaHref}
          class="inline-flex items-center justify-center px-8 py-3.5 rounded-full text-sm font-bold text-white bg-orange-600 hover:bg-orange-700 active:bg-orange-800 transition-all hover:scale-102 shadow-md shadow-orange-600/10 cursor-pointer"
        >
          {ctaText}
        </a>
      </div>
    </div>

  </div>
</section>
