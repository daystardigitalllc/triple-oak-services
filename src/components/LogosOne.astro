---
type Props = {
  class?: string
  title: string
  description?: string
  brands: {
    name: string
    href?: string
  }[]
}

const { class: className, title, description, brands } = Astro.props
---

<section class:list={["relative flex scroll-mt-12 flex-col gap-16 py-16 bg-background w-full", className]} data-slot="section">
  <div class="relative mx-auto flex w-full max-w-7xl flex-col gap-8 px-4 items-center gap-10 text-center">
    <div class="flex max-w-2xl flex-col items-center gap-4">
      <h2 class="text-foreground text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        {title}
      </h2>
      {
        description && (
          <p class="text-muted-foreground text-lg leading-relaxed text-balance">
            {description}
          </p>
        )
      }
    </div>
    <div class="text-muted-foreground flex w-full flex-wrap items-center justify-center gap-x-12 gap-y-6">
      {
        brands.map((brand) => {
          const Comp = brand.href ? "a" : "div";
          return (
            <Comp
              class="flex h-10 items-center justify-start gap-2 text-base font-semibold whitespace-nowrap hover:text-foreground grayscale transition-all hover:grayscale-0"
              href={brand.href}
            >
              <span class="text-lg">{brand.name}</span>
            </Comp>
          )
        })
      }
    </div>
  </div>
</section>
