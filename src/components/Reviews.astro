---
import contentData from '../data/content.json';
import themeConfig from '../data/theme.config.json';

const isOakCity = themeConfig.style === 'oak-city';
const cardClass = themeConfig.style === 'sharp-contractor' || isOakCity ? 'contractor-panel' : 'glass-panel';
const bgClass = themeConfig.style === 'sharp-contractor' || isOakCity ? 'bg-white dark:bg-slate-900' : 'bg-white/65 dark:bg-slate-950/65';
---

<style>
  /* Custom scrollbar hiding utilities */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>

<section id="reviews" class="py-24 bg-slate-50 dark:bg-slate-900/40 relative border-t border-slate-100 dark:border-slate-900/60">
  <div class="container mx-auto px-6">
    <!-- Header -->
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-16 md:mb-20">
      <span class="text-xs font-bold uppercase tracking-wider text-primary bg-primary/10 px-3 py-1.5 rounded-full">
        Testimonials
      </span>
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white uppercase leading-[1.1]">
        What Our Clients Say
      </h2>
      <p class="text-base sm:text-lg text-slate-500 dark:text-slate-400 font-normal">
        Read real feedback from local homeowners who experienced our premium craftsmanship.
      </p>
    </div>

    <!-- Reviews Container -->
    <div class:list={[
      isOakCity 
        ? "flex overflow-x-auto snap-x snap-mandatory gap-6 pb-6 scrollbar-hide -mx-6 px-6" 
        : "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
    ]}>
      {contentData.reviews.map((review) => (
        <div class:list={[
          cardClass, 
          bgClass, 
          isOakCity ? "shrink-0 w-[90%] sm:w-[48%] lg:w-[32%] snap-center" : "",
          "p-8 rounded-custom border border-slate-200/50 dark:border-slate-800/50 shadow-md flex flex-col justify-between space-y-6 transition-all hover:shadow-lg"
        ]}>
          
          <!-- Rating -->
          <div class="space-y-3">
            <div class="flex text-accent text-lg">
              {Array.from({ length: review.rating }).map(() => (
                <span>★</span>
              ))}
            </div>
            <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed italic font-normal">
              "{review.text}"
            </p>
          </div>

          <!-- Author Details -->
          <div class="flex items-center gap-3 pt-4 border-t border-slate-100 dark:border-slate-900">
            <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-extrabold text-sm">
              {review.author.charAt(0)}
            </div>
            <div>
              <h4 class="font-bold text-sm text-slate-950 dark:text-white uppercase tracking-tight">{review.author}</h4>
              <p class="text-xs text-slate-400 dark:text-slate-500 font-semibold">{review.location}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* Horizontal Scroll Helper Dots for Oak City */}
    {isOakCity && (
      <div class="flex items-center justify-center gap-2 pt-6 text-[10px] text-slate-400 font-bold uppercase tracking-wider select-none animate-pulse">
        <span>← Swipe to Scroll Testimonials →</span>
      </div>
    )}
  </div>
</section>
