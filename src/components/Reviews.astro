---
import contentData from '../data/content.json';
---

<style>
  /* Custom scrollbar hiding utilities */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>

<section id="reviews" class="py-24 bg-neutral-50 relative border-t border-neutral-100">
  <div class="container mx-auto px-6">
    <!-- Header -->
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-16 md:mb-20">
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-neutral-900 uppercase leading-[1.1]">
        What Nashville Homeowners Say
      </h2>
      <p class="text-base sm:text-lg text-neutral-500 font-normal">
        Real feedback from homeowners across the Nashville area.
      </p>
    </div>

    <!-- Reviews Container -->
    <div class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-6 scrollbar-hide -mx-6 px-6">
      {contentData.reviews.map((review) => (
        <div class="shrink-0 w-[90%] sm:w-[48%] lg:w-[32%] snap-center bg-white p-8 rounded-custom border border-neutral-200 shadow-md flex flex-col justify-between space-y-6 transition-all hover:shadow-lg">

          <!-- Rating -->
          <div class="space-y-3">
            <div class="flex text-accent text-lg">
              {Array.from({ length: review.rating }).map(() => (
                <span>★</span>
              ))}
            </div>
            <p class="text-neutral-600 text-sm leading-relaxed italic font-normal">
              "{review.text}"
            </p>
          </div>

          <!-- Author Details -->
          <div class="flex items-center gap-3 pt-4 border-t border-neutral-100">
            <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-extrabold text-sm">
              {review.author.charAt(0)}
            </div>
            <div>
              <h4 class="font-bold text-sm text-neutral-950 uppercase tracking-tight">{review.author}</h4>
              <p class="text-xs text-neutral-400 font-semibold">{review.location}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="flex items-center justify-center gap-2 pt-6 text-[10px] text-neutral-400 font-bold uppercase tracking-wider select-none animate-pulse">
      <span>&larr; Swipe to Scroll Testimonials &rarr;</span>
    </div>
  </div>
</section>
