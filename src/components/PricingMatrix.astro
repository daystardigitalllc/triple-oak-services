---
// PricingMatrix.astro
// Granular feature comparison matrix for plans & service scopes.
// Renders a comparison table comparing 3 tiers side-by-side.
import contentData from '../data/content.json';

interface CompareFeature {
  name: string;
  basic: string | boolean;
  premium: string | boolean;
  elite: string | boolean;
}

interface CompareGroup {
  groupName: string;
  features: CompareFeature[];
}

interface Props {
  badgeOverride?: string;
  headingOverride?: string;
  matrixGroupsOverride?: CompareGroup[];
}

const {
  badgeOverride,
  headingOverride,
  matrixGroupsOverride
} = Astro.props;

const data = contentData.home?.pricingMatrix;

const badge = badgeOverride || data?.badge || 'COMPARE DETAILS';
const heading = headingOverride || data?.title || 'Granular Service Scope Comparison';

const defaultGroups: CompareGroup[] = [
  {
    groupName: 'Covered Infestations',
    features: [
      { name: 'Common Ants & Roaches', basic: true, premium: true, elite: true },
      { name: 'Spiders & Centipedes', basic: true, premium: true, elite: true },
      { name: 'Bedbugs & Wasps', basic: false, premium: true, elite: true },
      { name: 'Rodents & Mice', basic: false, premium: true, elite: true },
      { name: 'Termite colonies', basic: false, premium: 'Addon option', elite: true }
    ]
  },
  {
    groupName: 'Inspections & Dispatch',
    features: [
      { name: 'Scheduled Tune-ups', basic: 'Bi-Annual', premium: 'Quarterly', elite: 'Monthly' },
      { name: 'Emergency dispatch time', basic: '48 Hours', premium: '12 Hours', elite: 'Same Day' },
      { name: 'Unlimited free re-treatments', basic: false, premium: true, elite: true },
      { name: 'Specialist account manager', basic: false, premium: false, elite: true }
    ]
  }
];

const groups = matrixGroupsOverride || data?.groups || defaultGroups;
---

<section id="pricing-matrix" class="py-24 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white select-none border-b border-slate-200 dark:border-slate-800">
  <div class="container mx-auto px-6 max-w-5xl space-y-16">
    
    <!-- Header -->
    <div class="mx-auto text-center max-w-3xl space-y-3">
      {badge && (
        <span class="text-xs font-bold uppercase tracking-wider text-red-650">
          {badge}
        </span>
      )}
      <h2 class="text-3xl sm:text-4.5xl font-black text-slate-950 dark:text-white tracking-tight leading-tight">
        {heading}
      </h2>
    </div>

    <!-- Responsive Comparison Table -->
    <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 shadow-lg bg-white dark:bg-slate-950">
      <table class="w-full text-left border-collapse min-w-[700px]">
        
        <!-- Table Header Banners -->
        <thead>
          <tr class="border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900">
            <th scope="col" class="p-6 text-xs font-black uppercase text-slate-400 tracking-wider w-[40%]">Service Features</th>
            <th scope="col" class="p-6 text-center text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider w-[20%]">DOA Basic</th>
            <th scope="col" class="p-6 text-center text-xs font-black uppercase text-red-650 tracking-wider w-[20%]">DOA Shield Plus</th>
            <th scope="col" class="p-6 text-center text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider w-[20%]">DOA Elite</th>
          </tr>
        </thead>

        <!-- Table Groups and Features details -->
        {groups.map((group) => (
          <tbody>
            <!-- Group Divider Title row -->
            <tr class="bg-slate-50/50 dark:bg-slate-900/40 border-b border-slate-200/60 dark:border-slate-800/60">
              <th colspan="4" class="px-6 py-4 text-xs font-black text-slate-400 uppercase tracking-widest bg-slate-100/30 dark:bg-slate-900/20">
                {group.groupName}
              </th>
            </tr>

            <!-- Features Rows -->
            {group.features.map((row) => (
              <tr class="border-b border-slate-100 dark:border-slate-900/60 hover:bg-slate-50/20 dark:hover:bg-slate-850/20">
                <td class="p-6 text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-300">{row.name}</td>
                
                <!-- Basic spec column -->
                <td class="p-6 text-center text-xs sm:text-sm font-bold text-slate-500">
                  {typeof row.basic === 'boolean' ? (
                    row.basic ? <span class="text-emerald-500 text-base font-black">✓</span> : <span class="text-slate-300">&mdash;</span>
                  ) : (
                    row.basic
                  )}
                </td>

                <!-- Premium spec column -->
                <td class="p-6 text-center text-xs sm:text-sm font-bold text-red-650 bg-red-50/5 dark:bg-red-950/5">
                  {typeof row.premium === 'boolean' ? (
                    row.premium ? <span class="text-emerald-500 text-base font-black">✓</span> : <span class="text-slate-350 dark:text-slate-600">&mdash;</span>
                  ) : (
                    row.premium
                  )}
                </td>

                <!-- Elite spec column -->
                <td class="p-6 text-center text-xs sm:text-sm font-bold text-slate-900 dark:text-white">
                  {typeof row.elite === 'boolean' ? (
                    row.elite ? <span class="text-emerald-500 text-base font-black">✓</span> : <span class="text-slate-300 dark:text-slate-600">&mdash;</span>
                  ) : (
                    row.elite
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        ))}

      </table>
    </div>

  </div>
</section>
