---
// GalleryScrollChoreography.astro
// Scroll-driven "choreography" gallery: four quadrant images assemble into a
// grid as the user scrolls, then a hero image expands to fill the viewport.
// Inspired by the "Scroll Choreography" concept on 21st.dev, rebuilt from
// scratch as a dependency-free Astro component (no React, no framer-motion —
// progress is tracked with a scroll listener and applied via CSS custom
// properties).
import contentData from '../data/content.json';
import businessData from '../data/business.json';

interface GalleryImage {
  src: string;
  alt: string;
}

interface Props {
  badgeOverride?: string;
  headingOverride?: string;
  subtitleOverride?: string;
  imagesOverride?: {
    topLeft: GalleryImage;
    topRight: GalleryImage;
    bottomLeft: GalleryImage;
    bottomRight: GalleryImage;
    hero: GalleryImage;
  };
  heroCaptionOverride?: string;
  ctaTextOverride?: string;
  ctaHrefOverride?: string;
}

const {
  badgeOverride,
  headingOverride,
  subtitleOverride,
  imagesOverride,
  heroCaptionOverride,
  ctaTextOverride,
  ctaHrefOverride,
} = Astro.props;

const showcase = contentData.home?.scrollShowcase;

const badge = badgeOverride || showcase?.badge || 'Our Craftsmanship';
const heading = headingOverride || showcase?.heading || `See ${businessData.name} in Action`;
const subtitle =
  subtitleOverride ||
  showcase?.subtitle ||
  'Scroll to watch a few of our favorite projects come together.';

const images = imagesOverride ||
  showcase?.images || {
    topLeft: { src: '/gallery-1.jpg', alt: 'Completed project detail, top left' },
    topRight: { src: '/gallery-2.jpg', alt: 'Completed project detail, top right' },
    bottomLeft: { src: '/gallery-3.jpg', alt: 'Completed project detail, bottom left' },
    bottomRight: { src: '/gallery-4.jpg', alt: 'Completed project detail, bottom right' },
    hero: { src: '/gallery-hero.jpg', alt: 'Signature completed project' },
  };

const heroCaption = heroCaptionOverride || showcase?.heroCaption || 'Our Signature Work';
const ctaText = ctaTextOverride || showcase?.ctaText || businessData.mainCta || 'Get a Free Estimate';
const ctaHref = ctaHrefOverride || showcase?.ctaHref || '#quote-funnel';

const uid = `choreo-${Math.random().toString(36).slice(2, 9)}`;
---

<section
  id="showcase"
  data-choreo-root
  data-choreo-id={uid}
  class="relative bg-slate-950"
  style="height: 400vh;"
>
  <div class="sticky top-0 h-screen w-full overflow-hidden">

    {/* Heading overlay — fades out as the quadrants assemble */}
    <div data-choreo-heading class="absolute inset-0 z-30 flex flex-col items-center justify-center text-center px-6 pointer-events-none">
      <span class="text-xs font-bold uppercase tracking-wider text-accent bg-accent/15 px-3.5 py-1.5 rounded-md border border-accent/25 mb-5">
        {badge}
      </span>
      <h2 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight uppercase leading-[1.1] max-w-3xl text-white">
        {heading}
      </h2>
      <p class="mt-4 max-w-xl text-sm sm:text-base text-slate-300">
        {subtitle}
      </p>
    </div>

    {/* Quadrant grid */}
    <div data-choreo-grid class="absolute inset-0 z-20 pointer-events-none">
      <div data-choreo-quad="tl" class="absolute top-0 left-0 w-1/2 h-1/2 p-1.5 sm:p-3">
        <img src={images.topLeft.src} alt={images.topLeft.alt} class="w-full h-full object-cover rounded-custom shadow-2xl" />
      </div>
      <div data-choreo-quad="tr" class="absolute top-0 right-0 w-1/2 h-1/2 p-1.5 sm:p-3">
        <img src={images.topRight.src} alt={images.topRight.alt} class="w-full h-full object-cover rounded-custom shadow-2xl" />
      </div>
      <div data-choreo-quad="bl" class="absolute bottom-0 left-0 w-1/2 h-1/2 p-1.5 sm:p-3">
        <img src={images.bottomLeft.src} alt={images.bottomLeft.alt} class="w-full h-full object-cover rounded-custom shadow-2xl" />
      </div>
      <div data-choreo-quad="br" class="absolute bottom-0 right-0 w-1/2 h-1/2 p-1.5 sm:p-3">
        <img src={images.bottomRight.src} alt={images.bottomRight.alt} class="w-full h-full object-cover rounded-custom shadow-2xl" />
      </div>
    </div>

    {/* Hero image — scales up to fill the screen at the end of the scroll */}
    <div data-choreo-hero class="absolute inset-0 z-10 flex items-center justify-center opacity-0">
      <div data-choreo-hero-inner class="relative w-full h-full overflow-hidden rounded-custom">
        <img src={images.hero.src} alt={images.hero.alt} class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
        <div data-choreo-hero-caption class="absolute bottom-10 left-0 right-0 flex flex-col items-center text-center px-6 opacity-0">
          <span class="text-[10px] font-extrabold uppercase tracking-widest text-white/80 mb-3">
            {heroCaption}
          </span>
          <a
            href={ctaHref}
            class="inline-flex items-center justify-center px-6 py-3 bg-primary hover:bg-primary-hover rounded-custom text-xs font-bold uppercase tracking-widest text-white transition-all hover:scale-105"
          >
            {ctaText}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ uid }}>
  (() => {
    const root = document.querySelector(`[data-choreo-id="${uid}"]`);
    if (!root) return;

    const heading = root.querySelector('[data-choreo-heading]');
    const quads = {
      tl: root.querySelector('[data-choreo-quad="tl"]'),
      tr: root.querySelector('[data-choreo-quad="tr"]'),
      bl: root.querySelector('[data-choreo-quad="bl"]'),
      br: root.querySelector('[data-choreo-quad="br"]'),
    };
    const hero = root.querySelector('[data-choreo-hero]');
    const heroInner = root.querySelector('[data-choreo-hero-inner]');
    const heroCaption = root.querySelector('[data-choreo-hero-caption]');

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Scatter offsets each quadrant starts from before assembling into the grid.
    const scatter = {
      tl: { x: -60, y: -60 },
      tr: { x: 60, y: -60 },
      bl: { x: -60, y: 60 },
      br: { x: 60, y: 60 },
    };

    const clamp = (v, min, max) => Math.max(min, Math.min(max, v));
    const lerp = (a, b, t) => a + (b - a) * t;

    function render(progress) {
      // Phase A 0 -> 0.4: quadrants scatter -> assembled grid, heading fades out.
      const pA = clamp(progress / 0.4, 0, 1);
      // Phase C 0.65 -> 1: grid fades out, hero scales up to fill screen.
      const pC = clamp((progress - 0.65) / 0.35, 0, 1);

      heading.style.opacity = String(1 - clamp(progress / 0.25, 0, 1));

      for (const key of Object.keys(quads)) {
        const el = quads[key];
        if (!el) continue;
        const off = scatter[key];
        const x = lerp(off.x, 0, pA);
        const y = lerp(off.y, 0, pA);
        const scale = lerp(0.85, 1, pA);
        const gridOpacity = 1 - pC;
        const gridScale = lerp(scale, 0.92, pC);
        el.style.transform = `translate(${x}%, ${y}%) scale(${gridScale})`;
        el.style.opacity = String(clamp(pA, 0, 1) * gridOpacity);
      }

      const heroScale = lerp(0.55, 1, pC);
      const heroRadius = lerp(1, 0, pC);
      hero.style.opacity = String(pC);
      heroInner.style.transform = `scale(${heroScale})`;
      heroInner.style.borderRadius = `calc(var(--radius-custom, 0.375rem) * ${heroRadius})`;

      const captionOpacity = clamp((progress - 0.9) / 0.1, 0, 1);
      heroCaption.style.opacity = String(captionOpacity);
    }

    if (prefersReducedMotion) {
      render(1);
      return;
    }

    render(0);

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const rect = root.getBoundingClientRect();
        const total = root.offsetHeight - window.innerHeight;
        const progress = total > 0 ? clamp(-rect.top / total, 0, 1) : 0;
        render(progress);
        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  })();
</script>
