---
// src/components/HeroBarracks.astro
// Distressed military/gaming-themed Hero block with bottom marquee ribbon.
import businessData from '../data/business.json';

interface Props {
  eyebrow?: string;
  headingPart1?: string;
  headingPart2?: string;
  headingPart3?: string;
  subtitle?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  bgImage?: string;
}

const {
  eyebrow = "WAR BARRACKS GAMING",
  headingPart1 = "BUILT DIFFERENT.",
  headingPart2 = "FOR GAMERS.",
  headingPart3 = "BY A VETERAN.",
  subtitle = "War Barracks Gaming is more than a store. It's a community, a mission, and the future of gaming.",
  primaryCtaText = "SHOP NOW",
  primaryCtaHref = "#",
  secondaryCtaText = "JOIN THE DISCORD",
  secondaryCtaHref = "#",
  bgImage = "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1600&q=80"
} = Astro.props;
---

<section 
  class="relative bg-black pt-32 pb-20 lg:pt-40 lg:pb-28 overflow-hidden min-h-[90vh] flex flex-col justify-between"
>
  <!-- Background Image with Dark Vignette Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src={bgImage} 
      alt="Gaming Lounge Background" 
      class="w-full h-full object-cover opacity-35 filter brightness-90 grayscale-[15%]" 
    />
    <!-- Heavy vignettes to guarantee readable content -->
    <div class="absolute inset-0 bg-gradient-to-r from-black via-black/85 to-black/40"></div>
    <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-black to-transparent"></div>
    <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-black to-transparent"></div>
  </div>

  <!-- Giant Glowing Watermark Shield SVG on the Right Wall -->
  <div class="absolute right-10 top-1/2 -translate-y-1/2 w-[450px] h-[450px] opacity-25 filter blur-[1px] pointer-events-none hidden lg:block text-red-700/60 drop-shadow-[0_0_60px_rgba(185,28,28,0.55)]">
    <svg viewBox="0 0 100 100" class="w-full h-full" fill="currentColor">
      <path d="M50 5 L90 20 L90 55 C90 75 70 90 50 95 C30 90 10 75 10 55 L10 20 Z" fill="none" stroke="currentColor" stroke-width="4" />
      <polygon points="50,22 58,38 76,41 63,54 66,72 50,63 34,72 37,54 24,41 42,38" />
    </svg>
  </div>

  <div class="container mx-auto px-6 relative z-10 flex-grow flex flex-col justify-center max-w-6xl">
    
    <!-- Hero Copy Column (Left Aligned) -->
    <div class="max-w-xl space-y-6">
      
      <!-- Eyebrow Tag -->
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 text-[10px] font-black tracking-widest text-red-500 bg-red-950/40 border border-red-800/40 rounded uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-red-650 animate-pulse"></span>
        {eyebrow}
      </span>

      <!-- Distressed Stenciled Heading -->
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tighter uppercase leading-tight select-none">
        <span class="text-white block border-b-2 border-transparent">{headingPart1}</span>
        <span class="text-red-600 block drop-shadow-[0_0_10px_rgba(220,38,38,0.2)]">{headingPart2}</span>
        <span class="text-white block">{headingPart3}</span>
      </h2>

      <!-- Subtitle -->
      <p class="text-sm sm:text-base text-slate-350 font-medium leading-relaxed">
        {subtitle}
      </p>

      <!-- CTAs (Buttons Group) -->
      <div class="flex flex-wrap gap-4 pt-4">
        <!-- Primary Action -->
        <a 
          href={primaryCtaHref}
          class="inline-flex items-center justify-center px-8 py-3.5 bg-red-700 hover:bg-red-600 active:bg-red-800 text-white font-black text-xs uppercase tracking-widest rounded border-b-4 border-red-900 transition-all hover:scale-102 cursor-pointer shadow-lg shadow-red-900/20"
        >
          {primaryCtaText}
        </a>

        <!-- Discord Button -->
        <a 
          href={secondaryCtaHref}
          class="inline-flex items-center justify-center px-6 py-3.5 bg-[#5865F2]/10 hover:bg-[#5865F2]/25 active:bg-[#5865F2]/45 text-white font-black text-xs uppercase tracking-widest rounded border border-[#5865F2]/50 transition-all flex items-center gap-2 cursor-pointer"
        >
          <!-- Discord Icon SVG -->
          <svg class="w-4 h-4 text-white" viewBox="0 0 127.14 96.36" fill="currentColor">
            <path d="M107.7,8.07A105.15,105.15,0,0,0,77.26,0a77.19,77.19,0,0,0-3.3,6.83A96.67,96.67,0,0,0,53.18,6.83,77.19,77.19,0,0,0,49.88,0,105.15,105.15,0,0,0,19.44,8.07C3.66,31.58-1.86,54.65,1,77.53A105.73,105.73,0,0,0,32,96.36a77.7,77.7,0,0,0,6.63-10.85,69.43,69.43,0,0,1-10.5-5c.87-.64,1.71-1.32,2.51-2a75.76,75.76,0,0,0,72.9,0c.8,0.7,1.64,1.38,2.51,2a69.43,69.43,0,0,1-10.5,5,77.7,77.7,0,0,0,6.63,10.85,105.73,105.73,0,0,0,31-18.83C129,54.65,122.56,31.58,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53S36.18,40.36,42.45,40.36,53.88,46,53.88,53,48.72,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53S78.41,40.36,84.69,40.36,96.12,46,96.12,53,91,65.69,84.69,65.69Z"/>
          </svg>
          {secondaryCtaText}
        </a>
      </div>

    </div>

    <!-- 4 Bullet Features Row (Distressed borders and badges) -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 pt-10 border-t border-white/10 mt-16 max-w-5xl">
      <!-- Feature 1 -->
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-full border border-red-700/60 bg-red-950/20 text-red-500 flex items-center justify-center shrink-0">
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5">
            <polygon points="12,2 15,9 22,9 17,14 19,21 12,17 5,21 7,14 2,9 9,9" />
          </svg>
        </div>
        <div>
          <h4 class="text-xs font-black uppercase text-white tracking-wider leading-none mb-1">VETERAN OWNED</h4>
          <p class="text-[10px] text-slate-450 leading-tight">Proudly veteran owned & operated</p>
        </div>
      </div>

      <!-- Feature 2 -->
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-full border border-red-700/60 bg-red-950/20 text-red-500 flex items-center justify-center shrink-0">
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5">
            <rect x="1" y="3" width="15" height="13" />
            <polygon points="16,8 20,8 23,11 23,16 16,16" />
            <circle cx="5.5" cy="18.5" r="2.5" />
            <circle cx="18.5" cy="18.5" r="2.5" />
          </svg>
        </div>
        <div>
          <h4 class="text-xs font-black uppercase text-white tracking-wider leading-none mb-1">FAST SHIPPING</h4>
          <p class="text-[10px] text-slate-450 leading-tight">Quick & Secure Worldwide Shipping</p>
        </div>
      </div>

      <!-- Feature 3 -->
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-full border border-red-700/60 bg-red-950/20 text-red-500 flex items-center justify-center shrink-0">
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
          </svg>
        </div>
        <div>
          <h4 class="text-xs font-black uppercase text-white tracking-wider leading-none mb-1">COMMUNITY FIRST</h4>
          <p class="text-[10px] text-slate-450 leading-tight">Built for Gamers, Powered by Community</p>
        </div>
      </div>

      <!-- Feature 4 -->
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-full border border-red-700/60 bg-red-950/20 text-red-500 flex items-center justify-center shrink-0">
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </div>
        <div>
          <h4 class="text-xs font-black uppercase text-white tracking-wider leading-none mb-1">SECURE CHECKOUT</h4>
          <p class="text-[10px] text-slate-450 leading-tight">Safe, Easy & Encrypted Payments</p>
        </div>
      </div>
    </div>

  </div>

  <!-- Bottom Running Ribbon Marquee -->
  <div class="w-full bg-black border-y border-red-750/70 py-3 mt-12 overflow-hidden select-none">
    <div class="flex gap-16 whitespace-nowrap animate-marquee text-[10px] font-black uppercase tracking-widest text-white">
      <div class="flex items-center gap-16 shrink-0">
        <span>VETERAN OWNED</span>
        <span class="w-1.5 h-1.5 rounded-full bg-red-650"></span>
        <span>FREE SHIPPING ON ORDERS OVER $35</span>
        <span class="w-1.5 h-1.5 rounded-full bg-red-650"></span>
        <span>GAMING LOUNGE</span>
        <span class="w-1.5 h-1.5 rounded-full bg-red-650"></span>
        <span>OPEN STREAMING SETUPS</span>
        <span class="w-1.5 h-1.5 rounded-full bg-red-650"></span>
        <span>TCG CARD TOURNAMENTS EVERY FRIDAY NIGHT</span>
        <span class="w-1.5 h-1.5 rounded-full bg-red-650"></span>
        <span>LAN TOURNAMENTS</span>
        <span class="w-1.5 h-1.5 rounded-full bg-red-650"></span>
      </div>
      <div class="flex items-center gap-16 shrink-0" aria-hidden="true">
        <span>VETERAN OWNED</span>
        <span class="w-1.5 h-1.5 rounded-full bg-red-650"></span>
        <span>FREE SHIPPING ON ORDERS OVER $35</span>
        <span class="w-1.5 h-1.5 rounded-full bg-red-650"></span>
        <span>GAMING LOUNGE</span>
        <span class="w-1.5 h-1.5 rounded-full bg-red-650"></span>
        <span>OPEN STREAMING SETUPS</span>
        <span class="w-1.5 h-1.5 rounded-full bg-red-650"></span>
        <span>TCG CARD TOURNAMENTS EVERY FRIDAY NIGHT</span>
        <span class="w-1.5 h-1.5 rounded-full bg-red-650"></span>
        <span>LAN TOURNAMENTS</span>
        <span class="w-1.5 h-1.5 rounded-full bg-red-650"></span>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    animation: marquee 25s linear infinite;
  }
</style>
