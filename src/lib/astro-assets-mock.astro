---
// src/lib/astro-assets-mock.astro
export async function getImage(options: any) {
  return {
    src: typeof options.src === 'object' && options.src !== null ? options.src.src : options.src,
    attributes: {}
  };
}

const { src, alt, class: className, ...props } = Astro.props;
const resolvedSrc = typeof src === 'object' && src !== null ? src.src : src;
---
<img src={resolvedSrc} alt={alt || ""} class={className} {...props} />
